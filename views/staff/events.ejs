<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Thông Tin Sự Kiện</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    
    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center gap-3 md:gap-4">
            <a href="/staff" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider hidden md:block">Trở lại</span>
            </a>
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Sự Kiện</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-calendar-event-fill text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">Danh sách sự kiện</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        <div class="relative mb-6">
            <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
            <input type="text" id="search-event" onkeyup="searchItems('search-event', '.event-card')" placeholder="Tìm sự kiện, địa điểm..." 
                   class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-rose-200 focus:border-rose-500 outline-none bg-white shadow-sm transition-colors">
        </div>
        
        <form action="/staff/events" method="GET" class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4 items-end">
            <div class="w-full md:flex-1">
                <label class="block text-xs font-bold text-gray-600 mb-1">Trạng thái sự kiện</label>
                <select name="status" class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-200 focus:border-rose-500 outline-none text-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="upcoming" <%= typeof query !== 'undefined' && query.status === 'upcoming' ? 'selected' : '' %>>Sắp tổ chức</option>
                    <option value="ongoing" <%= typeof query !== 'undefined' && query.status === 'ongoing' ? 'selected' : '' %>>Đang diễn ra</option>
                    <option value="completed" <%= typeof query !== 'undefined' && query.status === 'completed' ? 'selected' : '' %>>Đã kết thúc</option>
                </select>
            </div>
            <div class="w-full md:flex-1">
                <label class="block text-xs font-bold text-gray-600 mb-1">Từ ngày (Bắt đầu)</label>
                <input type="date" name="start_date" value="<%= typeof query !== 'undefined' ? query.start_date || '' : '' %>"
                    class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-200 focus:border-rose-500 outline-none text-sm">
            </div>
            <div class="w-full md:flex-1">
                <label class="block text-xs font-bold text-gray-600 mb-1">Đến ngày</label>
                <input type="date" name="end_date" value="<%= typeof query !== 'undefined' ? query.end_date || '' : '' %>"
                    class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-200 focus:border-rose-500 outline-none text-sm">
            </div>
            <div class="flex gap-2 w-full md:w-auto">
                <button type="submit" class="flex-1 md:flex-none px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                <a href="/staff/events" class="flex-1 md:flex-none px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-lg font-bold text-sm transition-colors flex items-center justify-center gap-2 text-center whitespace-nowrap">
                    Bỏ lọc
                </a>
            </div>
        </form>

        <% if (events.length === 0) { %>
            <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-200 text-center">
                <i class="bi bi-calendar-x text-5xl text-slate-300 mb-3 block"></i>
                <p class="text-slate-600 font-medium m-0">Không có sự kiện nào phù hợp.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <% events.forEach(ev => { 
                    const now = new Date();
                    const start = new Date(ev.start_time);
                    const end = new Date(ev.end_time);
                    let statusText = '';
                    let statusColor = '';
                    if (now < start) { statusText = 'Sắp tổ chức'; statusColor = 'bg-blue-100 text-blue-700 border-blue-200'; } 
                    else if (now >= start && now <= end) { statusText = 'Đang diễn ra'; statusColor = 'bg-emerald-100 text-emerald-700 border-emerald-200 animate-pulse'; } 
                    else { statusText = 'Đã kết thúc'; statusColor = 'bg-slate-100 text-slate-500 border-slate-200'; }
                %>
                    <a href="/staff/events/<%= ev.id %>" class="event-card relative bg-white p-5 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-rose-500 hover:shadow-md transition-all flex flex-col group">
                        <div class="flex justify-between items-start gap-2 mb-3">
                            <h4 class="text-lg font-bold text-gray-800 mt-0 group-hover:text-rose-600 transition-colors"><%= ev.event_name %></h4>
                            <span class="px-2 py-1 rounded text-[10px] font-black uppercase tracking-widest border shadow-sm whitespace-nowrap <%= statusColor %>"><%= statusText %></span>
                        </div>
                        <div class="flex items-start gap-2 mb-1.5 text-sm text-slate-700"><i class="bi bi-geo-alt-fill text-rose-500 mt-0.5"></i> <span class="font-bold"><%= ev.location %></span></div>
                        <div class="flex items-start gap-2 text-sm text-slate-700"><i class="bi bi-clock-fill text-amber-500 mt-0.5"></i> <span>Bắt đầu: <b class="text-slate-900"><%= formatDateTime(ev.start_time) %></b></span></div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </div>

    <script>
        function searchItems(inputId, itemClass) {
            const keyword = document.getElementById(inputId).value.toLowerCase();
            const items = document.querySelectorAll(itemClass);
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(keyword) ? 'flex' : 'none';
            });
        }
    </script>
</body>
</html>