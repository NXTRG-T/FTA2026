<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gắn Tag Khách Hàng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-gray-800 pb-20">
    
    <nav class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white p-4 shadow-md flex items-center gap-3 sticky top-0 z-50">
        <a href="/staff/customers" class="text-white hover:text-indigo-100 transition-colors text-xl"><i class="bi bi-arrow-left"></i></a>
        <h3 class="font-bold text-lg m-0 text-white">Phân loại khách hàng</h3>
    </nav>

    <div class="max-w-2xl mx-auto p-4 md:p-6">
        <form action="/staff/customers/<%= customerId %>/tags" method="POST" class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
            <p class="text-slate-800 font-bold mb-5 pb-4 border-b border-slate-200 flex items-center gap-2">
                <i class="bi bi-tags-fill text-indigo-600 text-xl"></i> Chọn các nhãn cho khách hàng:
            </p>
            
            <div class="space-y-3 mb-8 max-h-[60vh] overflow-y-auto pr-2">
                <% allTags.forEach(tag => { %>
                    <label class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition-colors group bg-white shadow-sm">
                        <input type="checkbox" name="tags" value="<%= tag.id %>" <%= currentTagIds.includes(tag.id) ? 'checked' : '' %> class="w-6 h-6 text-indigo-600 bg-white border-slate-300 rounded focus:ring-indigo-500 cursor-pointer">
                        <div class="flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full shadow-sm border border-slate-200" style="background-color: <%= tag.color_code %>;"></span>
                            <span class="font-black text-lg text-slate-800 group-hover:text-indigo-700 transition-colors">
                                <%= tag.tag_name %>
                            </span>
                        </div>
                    </label>
                <% }) %>
            </div>

            <button type="submit" class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-black text-lg transition-colors shadow-sm flex justify-center items-center gap-2">
                <i class="bi bi-check-circle-fill"></i> LƯU THAY ĐỔI
            </button>
        </form>
    </div>
</body>
</html>