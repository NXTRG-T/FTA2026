<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông Báo Nội Bộ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    
    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 md:gap-4">
            <div class="flex items-center gap-3 md:gap-4 flex-1 min-w-0">
                <a href="/staff" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                    <i class="bi bi-arrow-left text-xl"></i>
                    <span class="text-sm font-black uppercase tracking-wider hidden md:block">Trở lại</span>
                </a>
                <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                    <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Thông Báo</h1>
                    <span class="text-white/40 font-light text-xl">|</span>
                    <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                        <i class="bi bi-bell-fill text-sm md:text-lg shrink-0"></i>
                        <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">Thông báo nội bộ</span>
                    </div>
                </div>
            </div>
            <form action="/staff/notifications/read-all" method="POST" class="m-0 shrink-0">
                <button type="submit" class="px-3 py-2 md:px-4 md:py-2 bg-white/20 hover:bg-white/30 rounded-xl font-bold text-xs md:text-sm transition-all active:scale-95 backdrop-blur-sm text-white border border-white/30 flex items-center gap-2">
                    <i class="bi bi-check2-all"></i> <span class="hidden md:inline">Đọc tất cả</span>
                </button>
            </form>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        <div class="relative group max-w-3xl mx-auto mb-8">
            <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
                <i class="bi bi-search text-slate-400 group-focus-within:text-fuchsia-600 transition-colors text-xl"></i>
            </div>
            <input type="text" id="search-noti" onkeyup="searchItems()" placeholder="Tìm thông báo..." 
                   class="w-full pl-16 pr-6 py-5 bg-white rounded-[2rem] shadow-sm border border-slate-200 focus:border-fuchsia-500 focus:ring-8 focus:ring-fuchsia-500/10 outline-none transition-all font-bold text-slate-700 text-lg placeholder:font-medium">
        </div>

        <% if (notifications.length === 0) { %>
            <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-200 text-center">
                <i class="bi bi-bell-slash text-5xl text-slate-300 mb-3 block"></i>
                <p class="text-slate-600 font-bold m-0">Không có thông báo nào mới.</p>
            </div>
        <% } else { %>
            <div class="space-y-4">
            <% notifications.forEach(noti => { %>
                <div class="noti-card bg-white p-5 rounded-2xl shadow-sm border <%= noti.is_read ? 'border-slate-200' : 'border-slate-200 border-l-4 border-l-fuchsia-600' %> transition-all" style="opacity: <%= noti.is_read ? '0.7' : '1' %>;">
                    
                    <div class="flex justify-between items-start mb-2 gap-2">
                        <h4 class="text-lg font-black text-slate-900 m-0 leading-tight"><%= noti.title %></h4>
                        <% if (!noti.is_read) { %>
                            <span class="bg-rose-600 text-white px-2 py-0.5 rounded-md text-xs font-black shrink-0 shadow-sm animate-pulse">MỚI</span>
                        <% } %>
                    </div>
                    
                    <p class="text-slate-600 text-xs font-bold mb-3 flex items-center gap-1 uppercase tracking-wide">
                        <i class="bi bi-clock-fill text-fuchsia-500"></i> <%= formatDateTime(noti.start_time) %>
                    </p>
                    
                    <div class="bg-slate-50 p-4 rounded-xl text-slate-800 font-medium whitespace-pre-line leading-relaxed mb-4 border border-slate-200">
                        <%= noti.content %>
                    </div>

                    <% if(noti.drive_link) { %>
                        <a href="<%= noti.drive_link %>" target="_blank" class="flex items-center justify-center gap-2 w-full py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold rounded-xl transition-colors mb-4 border border-blue-200">
                            <i class="bi bi-link-45deg text-lg"></i> Xem Đính Kèm (Drive/Hình ảnh)
                        </a>
                    <% } %>

                    <% if (!noti.is_read) { %>
                        <form action="/staff/notifications/read/<%= noti.id %>" method="POST" class="m-0 flex justify-end pt-3 border-t border-dashed border-slate-200">
                            <button type="submit" class="px-4 py-2 bg-fuchsia-600 hover:bg-fuchsia-700 text-white font-bold rounded-xl transition-colors text-sm flex items-center gap-1 shadow-sm">
                                <i class="bi bi-check2-all text-lg"></i> Xác nhận đã đọc
                            </button>
                        </form>
                    <% } %>
                </div>
            <% }) %>
            </div>
        <% } %>
    </div>

    <script>
        function searchItems() {
            const keyword = document.getElementById('search-noti').value.toLowerCase();
            const items = document.querySelectorAll('.noti-card');
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(keyword) ? 'block' : 'none';
            });
        }
    </script>
</body>
</html>