<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khách Hàng Đã Xóa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    
    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center gap-3 md:gap-4">
            <a href="/staff" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider hidden md:block">Trở lại</span>
            </a>
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Thùng Rác</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-trash-fill text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">Khách hàng đã xóa</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        <% if (deletedCustomers.length === 0) { %>
            <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-200 text-center mt-6">
                <div class="w-20 h-20 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border border-slate-200">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <p class="text-slate-800 font-black text-xl m-0 mb-1">Thùng rác trống.</p>
                <p class="text-slate-500 font-medium text-sm m-0">Không có khách hàng nào bị xóa gần đây.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-2">
            <% deletedCustomers.forEach(cust => { %>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 border-t-4 border-t-red-600 flex flex-col hover:shadow-md transition-shadow">
                    <strong class="text-xl font-black text-slate-900 mb-1"><%= cust.full_name %></strong>
                    <p class="mb-3 text-slate-800 font-bold flex items-center gap-2"><i class="bi bi-telephone-fill text-slate-400"></i> <%= cust.phone_1 %></p>
                    
                    <div class="bg-slate-50 p-3 rounded-xl mb-4 border border-slate-200">
                        <p class="m-0 text-red-600 text-xs font-bold flex items-center gap-1 uppercase tracking-wide">
                            <i class="bi bi-clock-history text-lg"></i> Đã xóa lúc: <%= formatDateTime(cust.deleted_at) %>
                        </p>
                    </div>
                    
                    <form action="/staff/customers/restore/<%= cust.id %>" method="POST" class="m-0 mt-auto">
                        <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl transition-colors flex justify-center items-center gap-2 shadow-sm">
                            <i class="bi bi-arrow-counterclockwise text-lg"></i> KHÔI PHỤC LẠI
                        </button>
                    </form>
                </div>
            <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>