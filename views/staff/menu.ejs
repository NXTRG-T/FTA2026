                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_events" gs-x="6" gs-y="0" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1"> 
                <div class="grid-stack-item-content">
                    <a href="/staff/events" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(244,63,94,0.15)] transition-shadow">
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-rose-400 to-red-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0"> 
                            <i class="bi bi-calendar-event-fill text-xl md:text-2xl"></i>
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Sự kiện</span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_documents" gs-x="8" gs-y="0" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1">
                <div class="grid-stack-item-content">
                    <a href="/staff/documents" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(168,85,247,0.15)] transition-shadow"> 
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-indigo-500 to-purple-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0"> 
                            <i class="bi bi-folder-fill text-xl md:text-2xl"></i> 
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Tài liệu</span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_profile" gs-x="10" gs-y="0" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1"> 
                <div class="grid-stack-item-content">
                    <a href="/staff/profile" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(6,182,212,0.15)] transition-shadow">
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-cyan-400 to-blue-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0">                             <i class="bi bi-person-vcard-fill text-xl md:text-2xl"></i> 
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Hồ sơ</span> 
                        </div>
                    </a>
                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_team" gs-x="4" gs-y="1" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1"> 
                <div class="grid-stack-item-content">
                    <a href="/staff/my-team" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(59,130,246,0.15)] transition-shadow"> 
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-blue-400 to-indigo-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0">
                            <i class="bi bi-diagram-3-fill text-xl md:text-2xl"></i> 
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Đội Nhóm</span> 
                        </div>
                    </a>
                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_notifications" gs-x="6" gs-y="1" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1">
                <div class="grid-stack-item-content">
                    <a href="/staff/notifications" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(168,85,247,0.15)] transition-shadow">
                        <span id="noti-badge" class="absolute top-2 right-2 md:top-3 md:right-3 bg-gradient-to-r from-red-500 to-rose-600 text-white rounded-full px-2 py-0.5 md:px-2.5 md:py-0.5 text-[10px] md:text-xs font-black shadow-lg animate-pulse border border-white/50 z-20 <%= (typeof unreadCount === 'undefined' || unreadCount <= 0) ? 'hidden' : 'flex items-center justify-center min-w-[20px] md:min-w-[24px]' %>">
                            <%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %>
                        </span> 
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-purple-400 to-fuchsia-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0">
                            <i class="bi bi-bell-fill text-xl md:text-2xl"></i> 
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Thông báo</span> 
                        </div>
                    </a>
                </div>
            </div>

            <div class="grid-stack-item" gs-id="widget_survey" gs-x="8" gs-y="1" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1">
                <div class="grid-stack-item-content">
                    <a href="/staff/survey" class="w-full h-full relative bg-white/40 backdrop-blur-xl border border-white/60 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.03)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:shadow-[0_15px_30px_rgba(16,185,129,0.15)] transition-shadow">
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-gradient-to-tr from-emerald-400 to-teal-500 text-white rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:scale-110 transition-transform shrink-0">
                            <i class="bi bi-ui-checks text-xl md:text-2xl"></i>
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-700 uppercase tracking-tight leading-tight truncate block w-full">Khảo sát</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- <div class="grid-stack-item" gs-id="widget_logout" gs-x="10" gs-y="1" gs-w="2" gs-h="1" gs-min-w="2" gs-min-h="1">
                <div class="grid-stack-item-content">
                    <a href="/auth/logout" onclick="return confirm('Đăng xuất khỏi hệ thống?');" class="w-full h-full relative bg-white/20 backdrop-blur-xl border border-white/40 p-3 md:p-5 rounded-[1.2rem] md:rounded-[2rem] shadow-[0_4px_20px_rgb(0,0,0,0.02)] group overflow-hidden flex flex-row items-center justify-start gap-3 md:gap-4 text-left hover:bg-rose-50/50 hover:border-rose-200 transition-colors">
                        <div class="relative z-10 w-12 h-12 md:w-14 md:h-14 bg-slate-100/50 text-slate-500 rounded-xl md:rounded-2xl flex items-center justify-center shadow-inner border border-white/50 group-hover:text-rose-500 group-hover:bg-rose-100/50 transition-all shrink-0"> 
                            <i class="bi bi-box-arrow-right text-xl md:text-2xl"></i> 
                        </div>
                        <div class="relative z-10 flex-1 min-w-0">
                            <span class="text-sm md:text-base font-black text-slate-500 group-hover:text-rose-500 uppercase tracking-tight leading-tight truncate block w-full transition-colors">Thoát 🚪</span> 
                        </div>
                    </a>
                </div>
            </div> -->

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/gridstack@8.2.1/dist/gridstack-all.js"></script> 
    <script>
        let grid;
        let tempLayout = null;

        const clickSound = new Audio("data:audio/mp3;base64,//NExAAAAANIAAAAAExBTUUzLjEwMKqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq");
        clickSound.volume = 0.5; 

        document.addEventListener('DOMContentLoaded', () => {
            let savedLayout = [];
            try {
                savedLayout = <%- typeof dashboard_layout !== 'undefined' && dashboard_layout ? dashboard_layout : '[]' %>;
            } catch(e) { console.error("Lỗi dữ liệu layout", e); } 
            
            grid = GridStack.init({
                cellHeight: '140px', 
                margin: 10,          
                animate: true,
                staticGrid: true,
                resizable: { handles: 'e, se, s, sw, w' } 
            });

            if (savedLayout && savedLayout.length > 0) {
                grid.batchUpdate(); 
                savedLayout.forEach(node => {
                    const el = document.querySelector(`[gs-id="${node.id}"]`);
                    if (el) {
                        grid.update(el, { x: node.x, y: node.y, w: node.w, h: node.h }); 
                    }
                });
                grid.commit(); 
            }

            // SSE Realtime Notifications
            const eventSource = new EventSource('/stream/notifications');
            eventSource.onmessage = function(event) {
                const data = JSON.parse(event.data); 
                if (data.type === 'NEW_NOTIFICATION') {
                    const badge = document.getElementById('noti-badge');
                    if (badge) {
                        let currentCount = parseInt(badge.innerText) || 0; 
                        badge.innerText = currentCount + 1;
                        badge.classList.remove('hidden');
                        badge.classList.add('flex', 'animate-bounce');
                        setTimeout(() => badge.classList.remove('animate-bounce'), 3000); 
                    }
                    clickSound.play().catch(e => console.log('Âm thanh bị chặn.')); 
                } else if (data.type === 'REMINDER') {
                    alert('⏰ BÁO THỨC CRM:\n' + data.message); 
                    clickSound.play().catch(e => console.log('Âm thanh bị chặn.')); 
                }
            };
            eventSource.onerror = function() { console.log("Thử lại kết nối SSE..."); }; 
        });

        function playClick() { clickSound.play().catch(()=>{}); }

        function enableEditMode() {
            playClick();
            tempLayout = grid.engine.nodes.map(n => ({ id: n.id, x: n.x, y: n.y, w: n.w, h: n.h })); 
            grid.setStatic(false); 
            document.getElementById('btn-edit-mode').classList.add('hidden');
            const btnLogout = document.getElementById('btn-logout');
            if (btnLogout) btnLogout.classList.add('hidden'); 
            document.getElementById('edit-controls').classList.remove('hidden');
            document.getElementById('edit-banner').classList.remove('hidden');
            document.querySelectorAll('.grid-stack-item-content').forEach(el => {
                el.classList.add('ring-2', 'ring-indigo-400', 'ring-dashed');
            }); 
        }

        function cancelEdit() {
            playClick();
            if (tempLayout) {
                grid.batchUpdate(); 
                tempLayout.forEach(node => {
                    const el = document.querySelector(`[gs-id="${node.id}"]`);
                    if (el) grid.update(el, { x: node.x, y: node.y, w: node.w, h: node.h });
                });
                grid.commit();
            }
            disableEditMode();
        }

        function disableEditMode() {
            grid.setStatic(true); 
            document.getElementById('btn-edit-mode').classList.remove('hidden');
            const btnLogout = document.getElementById('btn-logout');
            if (btnLogout) btnLogout.classList.remove('hidden'); 
            document.getElementById('edit-controls').classList.add('hidden');
            document.getElementById('edit-banner').classList.add('hidden');
            document.querySelectorAll('.grid-stack-item-content').forEach(el => {
                el.classList.remove('ring-2', 'ring-indigo-400', 'ring-dashed');
            }); 
        }

        async function saveDashboardLayout() {
            playClick();
            const currentLayout = grid.engine.nodes.map(n => ({ id: n.id, x: n.x, y: n.y, w: n.w, h: n.h })); 
            try {
                const response = await fetch('/staff/dashboard/save-layout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ layout: currentLayout })
                }); 
                if ((await response.json()).success) {
                    disableEditMode();
                    alert('✅ Đã lưu bố cục thành công!'); 
                }
            } catch (error) { alert('🛑 Lỗi kết nối.'); }
        }

        async function resetDashboardLayout() {
            if(!confirm('Bạn có chắc muốn khôi phục giao diện mặc định?')) return; 
            playClick();
            try {
                const response = await fetch('/staff/dashboard/reset-layout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if ((await response.json()).success) {
                    alert('✅ Đã khôi phục mặc định!');
                    window.location.reload(); 
                }
            } catch (error) { alert('🛑 Lỗi khôi phục.'); }
        }
    </script>
</body>
</html>