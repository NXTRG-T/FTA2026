<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tài Liệu Nội Bộ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    
    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center gap-3 md:gap-4">
            <a href="/staff" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider hidden md:block">Trở lại</span>
            </a>
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Kho Tài Liệu</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-folder-fill text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">Tài liệu nội bộ</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        
        <div class="relative group max-w-3xl mx-auto mb-8">
            <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
                <i class="bi bi-search text-slate-400 group-focus-within:text-cyan-600 transition-colors text-xl"></i>
            </div>
            <input type="text" id="search-doc" onkeyup="searchItems()" placeholder="Tìm kiếm tài liệu..." 
                   class="w-full pl-16 pr-6 py-5 bg-white rounded-[2rem] shadow-sm border border-slate-200 focus:border-cyan-500 focus:ring-8 focus:ring-cyan-500/10 outline-none transition-all font-bold text-slate-700 text-lg placeholder:font-medium">
        </div>

        <% if (documents.length === 0) { %>
            <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-200 text-center">
                <i class="bi bi-folder2-open text-5xl text-slate-300 mb-3 block"></i>
                <p class="text-slate-600 font-medium m-0">Chưa có tài liệu nào trong kho.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <% documents.forEach(doc => { %>
                <div class="doc-card bg-white p-5 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-l-cyan-500 hover:border-cyan-400 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col group">
                    
                    <h4 class="text-lg font-black text-slate-900 mb-1 mt-0 group-hover:text-cyan-700 transition-colors"><%= doc.title %></h4>
                    
                    <p class="text-xs font-bold text-slate-500 mb-3 flex items-center gap-1 uppercase tracking-wide">
                        <i class="bi bi-clock-fill text-cyan-600"></i> <%= formatDateTime(doc.updated_at) %>
                    </p>
                    
                    <% if(doc.document_type) { %>
                        <span class="inline-block bg-cyan-50 text-cyan-700 text-xs font-bold px-2.5 py-1 rounded-md mb-3 w-max"><i class="bi bi-tag-fill"></i> <%= doc.document_type %></span>
                    <% } %>

                    <% if(doc.description) { %>
                        <div class="bg-slate-50 p-3.5 rounded-xl text-sm text-slate-700 font-medium mb-4 border border-slate-200 whitespace-pre-line leading-relaxed">
                            <%= doc.description %>
                        </div>
                    <% } %>

                    <div class="mt-auto pt-2">
                        <a href="<%= doc.file_link %>" target="_blank" class="w-full flex justify-center items-center gap-2 py-3 bg-cyan-600 hover:bg-cyan-700 text-white font-black rounded-xl transition-colors shadow-sm">
                            <i class="bi bi-cloud-arrow-down-fill text-lg"></i> XEM / TẢI VỀ
                        </a>
                    </div>
                </div>
            <% }) %>
            </div>
        <% } %>
    </div>

    <script>
        function searchItems() {
            const keyword = document.getElementById('search-doc').value.toLowerCase();
            const items = document.querySelectorAll('.doc-card');
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(keyword) ? 'flex' : 'none';
            });
        }
    </script>
</body>
</html>