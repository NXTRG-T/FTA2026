<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Tuyển Dụng (Tabs Kanban)</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Animation chuyển Tab */
        .fade-in {
            animation: fadeIn 0.3s ease-in-out forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="bg-slate-50 font-sans text-slate-800 pb-20">
    <div class="max-w-[1440px] mx-auto p-4 md:p-8">

        <div class="mb-5">
            <a href="<%= user.role === 'Admin' ? '/admin/dashboard' : '/staff' %>"
                class="inline-flex items-center gap-2 px-5 py-3 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-xl font-bold text-sm uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-lg group-hover:-translate-x-1 transition-transform"></i> 🏠 Về Dashboard
            </a>
        </div>

        <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 mb-6 bg-white p-6 rounded-[2rem] shadow-sm border border-slate-200">
            <div>
                <h2 class="text-2xl md:text-3xl font-black text-indigo-700 tracking-tight m-0 flex items-center gap-3">
                    🎯 Quản lý Tuyển Dụng
                </h2>
                <p class="text-slate-600 font-bold text-xs uppercase tracking-widest mt-2 m-0">Danh sách nhân sự do bạn
                    quản lý hoặc giới thiệu</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
                <div class="relative w-full sm:w-64">
                    <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="searchKanbanInput" placeholder="Tìm tên, SĐT..."
                        class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold focus:bg-white focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 outline-none transition-all shadow-sm">
                </div>
                <button onclick="forceReload()"
                    class="px-4 py-3 bg-white border border-slate-200 text-slate-600 hover:text-indigo-600 hover:border-indigo-300 rounded-xl font-bold transition-transform hover:scale-105 flex items-center justify-center shadow-sm shrink-0"
                    title="Tải lại trang (Shift + F5)">
                    <i class="bi bi-arrow-clockwise text-lg"></i>
                </button>
                <button onclick="copyAffiliateLink()"
                    class="px-5 py-3 bg-indigo-600 text-white hover:bg-indigo-700 rounded-xl font-bold text-sm uppercase tracking-widest transition-transform hover:scale-105 flex items-center gap-2 shadow-md justify-center shrink-0">
                    <i class="bi bi-link-45deg text-lg"></i> Copy Link
                </button>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6" id="tabsContainer">

            <div id="tab-APPLIED" data-status="APPLIED" onclick="switchTab('APPLIED')"
                class="status-tab cursor-pointer bg-white border-2 border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center transition-all hover:bg-slate-50 opacity-50 relative overflow-hidden">
                <div class="text-xl mb-1 text-slate-400 tab-icon"><i class="bi bi-inbox-fill"></i></div>
                <h3 class="font-black text-[10px] md:text-xs text-slate-600 uppercase tracking-widest tab-title">Mới ứng
                    tuyển</h3>
                <span
                    class="count-badge absolute top-2 right-2 text-[12px] font-black bg-slate-100 text-slate-500 px-2 py-0.5 rounded-md">
                    <%= boardData.APPLIED.length %>
                </span>
            </div>

            <div id="tab-INTERVIEWING" data-status="INTERVIEWING" onclick="switchTab('INTERVIEWING')"
                class="status-tab cursor-pointer bg-white border-2 border-blue-100 rounded-2xl p-4 flex flex-col items-center justify-center text-center transition-all hover:bg-blue-50/50 opacity-50 relative overflow-hidden">
                <div class="text-xl mb-1 text-blue-400 tab-icon"><i class="bi bi-chat-dots-fill"></i></div>
                <h3 class="font-black text-[10px] md:text-xs text-blue-800 uppercase tracking-widest tab-title">Phỏng
                    vấn</h3>
                <span
                    class="count-badge absolute top-2 right-2 text-[12px] font-black bg-blue-50 text-blue-600 px-2 py-0.5 rounded-md">
                    <%= boardData.INTERVIEWING.length %>
                </span>
            </div>

            <div id="tab-PROBATION" data-status="PROBATION" onclick="switchTab('PROBATION')"
                class="status-tab cursor-pointer bg-white border-2 border-amber-100 rounded-2xl p-4 flex flex-col items-center justify-center text-center transition-all hover:bg-amber-50/50 opacity-50 relative overflow-hidden">
                <div class="text-xl mb-1 text-amber-500 tab-icon"><i class="bi bi-hourglass-split"></i></div>
                <h3 class="font-black text-[10px] md:text-xs text-amber-800 uppercase tracking-widest tab-title">Thử
                    việc</h3>
                <span
                    class="count-badge absolute top-2 right-2 text-[12px] font-black bg-amber-50 text-amber-600 px-2 py-0.5 rounded-md">
                    <%= boardData.PROBATION.length %>
                </span>
            </div>

            <div id="tab-OFFICIAL" data-status="OFFICIAL" onclick="switchTab('OFFICIAL')"
                class="status-tab cursor-pointer bg-white border-2 border-emerald-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center transition-all hover:bg-emerald-50/50 opacity-50 relative overflow-hidden">
                <div class="text-xl mb-1 text-emerald-500 tab-icon"><i class="bi bi-patch-check-fill"></i></div>
                <h3 class="font-black text-[10px] md:text-xs text-emerald-800 uppercase tracking-widest tab-title">Chính
                    thức</h3>
                <span
                    class="count-badge absolute top-2 right-2 text-[12px] font-black bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-md">
                    <%= boardData.OFFICIAL.length %>
                </span>
            </div>

            <div id="tab-REJECTED" data-status="REJECTED" onclick="switchTab('REJECTED')"
                class="status-tab cursor-pointer bg-white border-2 border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center text-center transition-all hover:bg-slate-100 opacity-50 relative md:col-span-1 col-span-2 overflow-hidden">
                <div class="text-xl mb-1 text-slate-400 tab-icon"><i class="bi bi-archive-fill"></i></div>
                <h3 class="font-black text-[10px] md:text-xs text-slate-500 uppercase tracking-widest tab-title">Lưu trữ
                </h3>
                <span
                    class="count-badge absolute top-2 right-2 text-[12px] font-black bg-slate-200 text-slate-600 px-2 py-0.5 rounded-md">
                    <%= boardData.REJECTED.length %>
                </span>
            </div>

        </div>

        <div class="bg-white rounded-[2rem] p-4 md:p-6 shadow-sm border border-slate-200 min-h-[500px]">

            <div id="list-APPLIED" class="kanban-list space-y-3 hidden" data-status="APPLIED">
                <% boardData.APPLIED.forEach(candidate=> { %>
                    <div class="kanban-card bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg transition-all group relative"
                        data-id="<%= candidate.id %>">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="<%= getDefaultAvatar(candidate.full_name, candidate.avatar_url) %>"
                                class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-slate-100"
                                alt="<%= candidate.full_name %>">
                            <div class="pr-6">
                                <h4
                                    class="card-name text-base font-black text-slate-800 leading-tight group-hover:text-indigo-600 transition-colors">
                                    <%= candidate.full_name %>
                                </h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <%= new Date(candidate.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-3 mb-3 border border-slate-100">
                            <p class="card-phone text-xs font-bold text-slate-600 mb-1.5 flex items-center gap-2"><i
                                    class="bi bi-telephone-fill text-indigo-400"></i>
                                <%= candidate.phone_1 %>
                            </p>
                            <% if(candidate.email) { %>
                                <p class="text-xs font-bold text-slate-500 flex items-center gap-2 truncate"><i
                                        class="bi bi-envelope-fill text-slate-400"></i>
                                    <%= candidate.email %>
                                </p>
                                <% } %>
                        </div>
                        <% if(candidate.cv_url) { %>
                            <div class="flex justify-end"><a href="<%= candidate.cv_url %>" target="_blank"
                                    class="text-[10px] font-black uppercase tracking-widest text-indigo-600 hover:text-white bg-indigo-50 hover:bg-indigo-600 border border-indigo-100 px-3 py-1.5 rounded-lg transition-all shadow-sm">📄
                                    Xem CV</a></div>
                            <% } %>
                    </div>
                    <% }) %>
                        <% if (boardData.APPLIED.length===50) { %> <button
                                class="w-full py-3 mt-2 bg-slate-200/50 hover:bg-slate-200 text-slate-500 font-bold rounded-xl text-xs uppercase tracking-widest transition-colors load-more-btn"
                                data-status="APPLIED" onclick="loadMoreKanban('APPLIED', this)">Tải thêm</button>
                            <% } %>
            </div>

            <div id="list-INTERVIEWING" class="kanban-list space-y-3 hidden" data-status="INTERVIEWING">
                <% boardData.INTERVIEWING.forEach(candidate=> { %>
                    <div class="kanban-card bg-white p-5 rounded-2xl shadow-sm border border-blue-100 hover:shadow-lg transition-all group relative"
                        data-id="<%= candidate.id %>">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="<%= getDefaultAvatar(candidate.full_name, candidate.avatar_url) %>"
                                class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-blue-100"
                                alt="<%= candidate.full_name %>">
                            <div class="pr-6">
                                <h4
                                    class="card-name text-base font-black text-slate-800 leading-tight group-hover:text-blue-600 transition-colors">
                                    <%= candidate.full_name %>
                                </h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <%= new Date(candidate.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                        </div>
                        <div class="bg-blue-50/50 rounded-xl p-3 border border-blue-50">
                            <p class="card-phone text-xs font-bold text-slate-600 flex items-center gap-2"><i
                                    class="bi bi-telephone-fill text-blue-400"></i>
                                <%= candidate.phone_1 %>
                            </p>
                        </div>
                    </div>
                    <% }) %>
                        <% if (boardData.INTERVIEWING.length===50) { %> <button
                                class="w-full py-3 mt-2 bg-blue-100/50 hover:bg-blue-100 text-blue-500 font-bold rounded-xl text-xs uppercase tracking-widest transition-colors load-more-btn"
                                data-status="INTERVIEWING" onclick="loadMoreKanban('INTERVIEWING', this)">Tải
                                thêm</button>
                            <% } %>
            </div>

            <div id="list-PROBATION" class="kanban-list space-y-3 hidden" data-status="PROBATION">
                <% boardData.PROBATION.forEach(candidate=> { %>
                    <div class="kanban-card bg-white p-5 rounded-2xl shadow-sm border border-amber-100 hover:shadow-lg transition-all group relative"
                        data-id="<%= candidate.id %>">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="<%= getDefaultAvatar(candidate.full_name, candidate.avatar_url) %>"
                                class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-amber-100"
                                alt="<%= candidate.full_name %>">
                            <div class="pr-6">
                                <h4
                                    class="card-name text-base font-black text-slate-800 leading-tight group-hover:text-amber-600 transition-colors">
                                    <%= candidate.full_name %>
                                </h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <%= new Date(candidate.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                        </div>
                        <div class="bg-amber-50/50 rounded-xl p-3 border border-amber-50">
                            <p class="card-phone text-xs font-bold text-slate-600 flex items-center gap-2"><i
                                    class="bi bi-telephone-fill text-amber-500"></i>
                                <%= candidate.phone_1 %>
                            </p>
                        </div>
                    </div>
                    <% }) %>
                        <% if (boardData.PROBATION.length===50) { %> <button
                                class="w-full py-3 mt-2 bg-amber-100/50 hover:bg-amber-100 text-amber-500 font-bold rounded-xl text-xs uppercase tracking-widest transition-colors load-more-btn"
                                data-status="PROBATION" onclick="loadMoreKanban('PROBATION', this)">Tải thêm</button>
                            <% } %>
            </div>

            <div id="list-OFFICIAL" class="kanban-list space-y-3 hidden" data-status="OFFICIAL">
                <% boardData.OFFICIAL.forEach(candidate=> { %>
                    <div class="kanban-card bg-white p-5 rounded-2xl shadow-sm border border-emerald-100 hover:shadow-lg transition-all group relative"
                        data-id="<%= candidate.id %>">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="<%= getDefaultAvatar(candidate.full_name, candidate.avatar_url) %>"
                                class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-emerald-100"
                                alt="<%= candidate.full_name %>">
                            <div>
                                <h4
                                    class="card-name text-base font-black text-slate-800 leading-tight group-hover:text-emerald-600 transition-colors">
                                    <%= candidate.full_name %>
                                </h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <%= new Date(candidate.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                        </div>
                        <div class="bg-emerald-50/50 rounded-xl p-3 border border-emerald-50">
                            <p class="card-phone text-xs font-bold text-slate-600 flex items-center gap-2 mb-2"><i
                                    class="bi bi-telephone-fill text-emerald-500"></i>
                                <%= candidate.phone_1 %>
                            </p>
                            <p
                                class="text-[10px] text-emerald-700 bg-emerald-100 border border-emerald-200 px-2 py-1.5 rounded uppercase tracking-widest w-fit font-black">
                                <i class="bi bi-shield-lock-fill"></i> Đã cấp tài khoản</p>
                        </div>
                    </div>
                    <% }) %>
                        <% if (boardData.OFFICIAL.length===50) { %> <button
                                class="w-full py-3 mt-2 bg-emerald-100/50 hover:bg-emerald-100 text-emerald-500 font-bold rounded-xl text-xs uppercase tracking-widest transition-colors load-more-btn"
                                data-status="OFFICIAL" onclick="loadMoreKanban('OFFICIAL', this)">Tải thêm</button>
                            <% } %>
            </div>

            <div id="list-REJECTED" class="kanban-list space-y-3 hidden" data-status="REJECTED">
                <% boardData.REJECTED.forEach(candidate=> { %>
                    <div class="kanban-card bg-slate-50 p-5 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition-all opacity-80"
                        data-id="<%= candidate.id %>">
                        <div class="flex items-center gap-3 mb-3">
                            <img src="<%= getDefaultAvatar(candidate.full_name, candidate.avatar_url) %>"
                                class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-slate-100"
                                alt="<%= candidate.full_name %>">
                            <div>
                                <h4
                                    class="card-name text-base font-black text-slate-600 leading-tight line-through decoration-slate-300">
                                    <%= candidate.full_name %>
                                </h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    <%= new Date(candidate.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                        </div>
                        <p class="card-phone text-xs font-bold text-slate-400 flex items-center gap-2"><i
                                class="bi bi-telephone-fill"></i>
                            <%= candidate.phone_1 %>
                        </p>
                    </div>
                    <% }) %>
                        <% if (boardData.REJECTED.length===50) { %> <button
                                class="w-full py-3 mt-2 bg-slate-200/50 hover:bg-slate-200 text-slate-500 font-bold rounded-xl text-xs uppercase tracking-widest transition-colors load-more-btn"
                                data-status="REJECTED" onclick="loadMoreKanban('REJECTED', this)">Tải thêm</button>
                            <% } %>
            </div>

        </div>

        <script>
    const baseUrl = '<%= user.role === "Admin" ? "/admin" : "/staff" %>';
    let currentActiveTab = 'APPLIED';

    // Hàm reload bỏ qua cache (giống Shift + F5)
    function forceReload() {
        const url = new URL(window.location.href);
        url.searchParams.set('_refresh', new Date().getTime());
        window.location.href = url.toString();
    }

    // 1. Script Copy Link (Giữ nguyên)
    function copyAffiliateLink() {
        const refCode = '<%= user.referral_code || "CODE_TEST" %>';
        const link = window.location.origin + '/?ref=' + refCode;
        navigator.clipboard.writeText(link);
        alert('Đã copy link giới thiệu: ' + link);
    }

    // 2. LOGIC TABS & GIAO DIỆN
    function switchTab(status) {
        currentActiveTab = status;

        // Tắt active tất cả các tabs
        document.querySelectorAll('.status-tab').forEach(tab => {
            tab.classList.remove('opacity-100', 'ring-2', 'ring-offset-2', 'ring-indigo-400', 'shadow-md', 'scale-105', 'bg-white');
            tab.classList.add('opacity-70', 'bg-slate-50/50');
        });
        
        // Bật active tab được chọn
        const activeTab = document.getElementById('tab-' + status);
        if (activeTab) {
            activeTab.classList.remove('opacity-70', 'bg-slate-50/50');
            activeTab.classList.add('opacity-100', 'bg-white', 'ring-2', 'ring-offset-2', 'ring-indigo-400', 'shadow-md', 'scale-105');
        }

        // Ẩn tất cả các List, hiện List tương ứng
        document.querySelectorAll('.kanban-list').forEach(list => {
            list.classList.add('hidden');
            list.classList.remove('fade-in');
        });
        
        const activeList = document.getElementById('list-' + status);
        if (activeList) {
            activeList.classList.remove('hidden');
            // Xóa đi vẽ lại class để kích hoạt animation CSS
            void activeList.offsetWidth;
            activeList.classList.add('fade-in');
        }
    }

    // Khởi chạy Tab Mặc định khi load trang
    document.addEventListener('DOMContentLoaded', () => {
        switchTab('APPLIED');
    });

    // Hàm đếm lại số lượng sau khi kéo thả
    function updateTabCounts() {
        ['APPLIED', 'INTERVIEWING', 'PROBATION', 'OFFICIAL', 'REJECTED'].forEach(status => {
            const list = document.getElementById('list-' + status);
            const countBadge = document.getElementById('tab-' + status)?.querySelector('.count-badge');
            if (list && countBadge) {
                const cardCount = list.querySelectorAll('.kanban-card').length;
                countBadge.innerText = cardCount;
            }
        });
    }

    // 3. BỘ LỌC TÌM KIẾM NHANH KANBAN
    const searchInput = document.getElementById('searchKanbanInput');
    if (searchInput) {
        searchInput.addEventListener('input', function (e) {
            const keyword = e.target.value.toLowerCase().trim();
            const cards = document.querySelectorAll('.kanban-card');

            cards.forEach(card => {
                const name = card.querySelector('.card-name')?.innerText.toLowerCase() || '';
                const phone = card.querySelector('.card-phone')?.innerText.toLowerCase() || '';

                if (name.includes(keyword) || phone.includes(keyword)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }

    // 4. LOGIC PHÂN TRANG (TẢI THÊM)
    async function loadMoreKanban(status, btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> Đang tải...';
        btn.disabled = true;

        const container = document.getElementById('list-' + status);
        const currentOffset = container.querySelectorAll('.kanban-card').length;

        try {
            const response = await fetch(baseUrl + `/api/recruitment/load-more?status=${status}&offset=${currentOffset}`);
            const result = await response.json();

            if (result.success && result.candidates.length > 0) {
                let nextStatus = '';
                if (status === 'APPLIED') { nextStatus = 'INTERVIEWING'; }
                else if (status === 'INTERVIEWING') { nextStatus = 'PROBATION'; }
                else if (status === 'PROBATION') { nextStatus = 'OFFICIAL'; }

                result.candidates.forEach(c => {
                    const date = new Date(c.created_at).toLocaleDateString('vi-VN');
                    const avatarUrl = c.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(c.full_name)}&background=random&color=fff&size=200&bold=true`;

                    const div = document.createElement('div');
                    div.className = `kanban-card bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:shadow-lg transition-all group relative`;
                    div.setAttribute('data-id', c.id);

                    let html = `
                        <div class="flex items-center gap-3 mb-3">
                            <img src="${avatarUrl}" class="w-10 h-10 rounded-full object-cover shrink-0 shadow-sm border-2 border-white ring-1 ring-slate-100" alt="${c.full_name}">
                            <div class="pr-6">
                                <h4 class="card-name text-base font-black text-slate-800 leading-tight">${c.full_name}</h4>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">${date}</span>
                            </div>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                            <p class="card-phone text-xs font-bold text-slate-600 flex items-center gap-2"><i class="bi bi-telephone-fill"></i> ${c.phone_1}</p>
                        </div>
                    `;
                    div.innerHTML = html;
                    container.insertBefore(div, btn);
                });

                updateTabCounts();

                if (result.candidates.length < 50) {
                    btn.remove();
                } else {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } else {
                btn.remove();
            }
        } catch (err) {
            btn.innerHTML = 'Lỗi, thử lại';
            btn.disabled = false;
        }
    }
</script>
    </div>
</body>

</html>