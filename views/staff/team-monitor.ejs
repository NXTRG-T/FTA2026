<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giám sát Đội nhóm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-slate-50 font-sans text-slate-800 pb-20">

    <div class="max-w-5xl mx-auto p-4 md:p-6 md:pt-8">

        <div class="mb-4">
            <a href="/staff"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-full font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Menu
            </a>
        </div>

        <div class="bg-white p-6 md:p-8 rounded-[2.5rem] shadow-sm border border-slate-200 mb-8 flex items-center gap-4 bg-gradient-to-r from-amber-50 to-white">
            <div class="w-16 h-16 bg-amber-500 rounded-[1.5rem] flex items-center justify-center text-white text-3xl shadow-lg shadow-amber-200 rotate-3">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0">Quản lý Đội nhóm</h2>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">
                    Số liệu tháng <%= typeof month !== 'undefined' ? month : 'Nay' %> / <%= typeof year !== 'undefined' ? year : '' %>
                </p>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
            <div class="relative w-full md:w-96">
                <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" id="searchIcon"></i>
                <i class="bi bi-arrow-repeat animate-spin absolute left-4 top-1/2 -translate-y-1/2 text-indigo-500 hidden" id="loadingIcon"></i>
                <input type="text" id="searchInput" oninput="handleSearchInput(event)" placeholder="Tìm tên hoặc SĐT tuyến dưới..." 
                       class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-400 outline-none transition-all text-sm font-medium">
            </div>

            <div class="flex gap-3 w-full md:w-auto">
                <select id="filterStatus" onchange="triggerFilter()" class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600 outline-none focus:ring-2 focus:ring-indigo-400 cursor-pointer">
                    <option value="ALL">Tất cả trạng thái</option>
                    <option value="PROBATION">Đang Thử việc</option>
                    <option value="OFFICIAL">Chính thức</option>
                </select>
                
                <select id="sortData" onchange="triggerFilter()" class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600 outline-none focus:ring-2 focus:ring-indigo-400 cursor-pointer">
                    <option value="newest">Mới nhất</option>
                    <option value="name_asc">Tên (A-Z)</option>
                </select>
            </div>
        </div>

        <div id="teamContainer" class="space-y-4">
            
            <% if (typeof isLeader !== 'undefined' && !isLeader) { %>
                <div class="text-center p-12 bg-white rounded-[3rem] border border-slate-200 shadow-sm">
                    <i class="bi bi-shield-lock-fill text-6xl text-slate-200 mb-4 block"></i>
                    <h3 class="text-xl font-black text-slate-800 mb-2">Bạn không có quyền truy cập</h3>
                    <p class="text-sm font-bold text-slate-400">Khu vực này chỉ dành cho Trưởng nhóm có nhân viên trực thuộc.</p>
                </div>
            <% } else { %>
                
                <% if (typeof teamMembers !== 'undefined' && teamMembers.length > 0) { %>
                    <% teamMembers.forEach(member => { %>
                        
                        <div class="accordion-item bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-4">
                            
                            <div onclick="toggleF1Branch('<%= member.id %>')" class="p-4 flex items-center justify-between cursor-pointer hover:bg-slate-50 transition-colors group">
                                <div class="flex items-center gap-4">
                                    <img src="<%= member.avatar_url || '/img/default-avatar.png' %>" class="w-12 h-12 rounded-full object-cover border-2 border-slate-100 shadow-sm">
                                    <div>
                                        <h4 class="font-black text-slate-800 group-hover:text-indigo-600 transition-colors"><%= member.full_name %></h4>
                                        <div class="flex gap-3 text-xs font-bold mt-1">
                                            <span class="text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100"><i class="bi bi-person-plus-fill"></i> <%= member.stats ? member.stats.new_cust : 0 %> Khách mới</span>
                                            <span class="text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100"><i class="bi bi-calendar-check-fill"></i> <%= member.stats ? member.stats.attended : 0 %> Dự sự kiện</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <button onclick="event.stopPropagation(); openKpiHistoryModal('<%= member.id %>')" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-indigo-500 text-slate-600 hover:text-white rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors">
                                        <i class="bi bi-clock-history"></i> Xem Điểm
                                    </button>
                                    <i id="icon-toggle-<%= member.id %>" class="bi bi-chevron-down text-xl text-slate-400 transition-transform duration-300"></i>
                                </div>
                            </div>

                            <div class="md:hidden border-t border-slate-50 p-3 bg-white text-right">
                                <button onclick="openKpiHistoryModal('<%= member.id %>')" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 hover:bg-indigo-500 text-indigo-600 hover:text-white rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors">
                                    <i class="bi bi-clock-history"></i> Xem Điểm
                                </button>
                            </div>

                            <div id="f2-container-<%= member.id %>" class="hidden border-t border-slate-100 bg-slate-50 p-4">
                                <div id="f2-list-<%= member.id %>" class="space-y-3">
                                    </div>
                                <div id="f2-loadmore-wrap-<%= member.id %>" class="mt-3 text-center hidden">
                                    <button onclick="loadMoreF2('<%= member.id %>')" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 px-4 py-2 bg-indigo-50 rounded-xl transition-colors">
                                        Tải thêm nhân sự...
                                    </button>
                                </div>
                            </div>

                        </div>

                    <% }) %>
                <% } else { %>
                    <div class="text-center py-10 text-slate-400 font-bold bg-white rounded-2xl border border-dashed border-slate-200">
                        Bạn chưa có nhân sự tuyến dưới nào!
                    </div>
                <% } %>
            <% } %>

        </div>
    </div>

    <div id="kpiHistoryModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col animate-[fadeIn_0.2s_ease-out]">
            <div class="flex justify-between items-center p-6 border-b border-slate-100 shrink-0">
                <h3 class="font-black text-xl text-slate-800 flex items-center gap-2 m-0"><i class="bi bi-journal-text text-indigo-500"></i> Lịch sử biến động KPI</h3>
                <button onclick="document.getElementById('kpiHistoryModal').classList.add('hidden')" class="text-slate-400 hover:text-rose-500 text-3xl leading-none">&times;</button>
            </div>
            <div class="p-6 overflow-y-auto bg-slate-50/50 flex-1" id="kpiTimelineContainer"></div>
        </div>
    </div>

    <script>
        const teamContainer = document.getElementById('teamContainer');
        let debounceTimer;

        // 1. TÌM KIẾM
        function handleSearchInput(event) {
            const keyword = event.target.value.trim();
            document.getElementById('searchIcon').classList.add('hidden');
            document.getElementById('loadingIcon').classList.remove('hidden');
            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(() => {
                if (keyword === '' && document.getElementById('filterStatus').value === 'ALL' && document.getElementById('sortData').value === 'newest') {
                    window.location.reload();
                    return;
                }
                fetchAndRenderList(keyword, true);
            }, 500);
        }

        function triggerFilter() {
            const keyword = document.getElementById('searchInput').value.trim();
            fetchAndRenderList(keyword, true);
        }

        // 2. TẢI DANH SÁCH LỌC
        async function fetchAndRenderList(keyword = '', isReset = false, offset = 0) {
            const status = document.getElementById('filterStatus').value;
            const sort = document.getElementById('sortData').value;
            const limit = 20;

            try {
                const response = await fetch(`/staff/api/team-members?search=${keyword}&status=${status}&sort_by=${sort}&limit=${limit}&offset=${offset}`);
                const result = await response.json();

                document.getElementById('searchIcon').classList.remove('hidden');
                document.getElementById('loadingIcon').classList.add('hidden');

                if (result.success) {
                    if (isReset) {
                        teamContainer.innerHTML = '';
                        if (result.members.length === 0) {
                            teamContainer.innerHTML = `<div class="text-center py-10 text-slate-400 font-bold bg-white rounded-2xl border border-dashed border-slate-200">Không tìm thấy nhân sự phù hợp!</div>`;
                            return;
                        }
                    }

                    let html = '';
                    result.members.forEach(member => {
                        const avatar = member.avatar_url || '/img/default-avatar.png';
                        const dateStr = member.created_at ? new Date(member.created_at).toLocaleDateString('vi-VN') : '';
                        
                        html += `
                            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between hover:shadow-md transition-shadow animate-[fadeIn_0.3s_ease-out]">
                                <div class="flex items-center gap-4">
                                    <img src="${avatar}" class="w-12 h-12 rounded-full object-cover border-2 border-slate-50">
                                    <div>
                                        <h4 class="font-black text-slate-800">${member.full_name}</h4>
                                        <p class="text-xs text-slate-500 font-medium"><i class="bi bi-telephone-fill text-slate-300"></i> ${member.phone_1} • ${member.work_status}</p>
                                    </div>
                                </div>
                                <button onclick="openKpiHistoryModal('${member.id}')" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors">
                                    <i class="bi bi-clock-history"></i> Xem Điểm
                                </button>
                            </div>
                        `;
                    });

                    const oldLoadMoreBtn = document.getElementById('btn-load-more');
                    if (oldLoadMoreBtn) oldLoadMoreBtn.remove();

                    teamContainer.insertAdjacentHTML('beforeend', html);

                    if (result.members.length === limit) {
                        const nextOffset = offset + limit;
                        teamContainer.insertAdjacentHTML('beforeend', `
                            <button id="btn-load-more" onclick="fetchAndRenderList('${keyword}', false, ${nextOffset})" class="w-full mt-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold text-sm rounded-2xl transition-colors">
                                Xem thêm nhân sự...
                            </button>
                        `);
                    }
                }
            } catch (error) {
                console.error(error);
                alert("Lỗi kết nối khi tải danh sách!");
            }
        }

        // 3. ACCORDION F2
        let f1Offsets = {};

        async function toggleF1Branch(f1Id) {
            const container = document.getElementById(`f2-container-${f1Id}`);
            const listWrap = document.getElementById(`f2-list-${f1Id}`);
            const icon = document.getElementById(`icon-toggle-${f1Id}`);
            
            if (!container.classList.contains('hidden')) {
                container.classList.add('hidden');
                icon.classList.remove('rotate-180');
                return;
            }

            container.classList.remove('hidden');
            icon.classList.add('rotate-180');

            if (listWrap.innerHTML.trim() !== '') return;

            listWrap.innerHTML = '<div class="text-center py-5 text-indigo-400"><i class="bi bi-arrow-repeat animate-spin text-xl"></i> Đang tải danh sách...</div>';
            f1Offsets[f1Id] = 0; 
            
            await loadMoreF2(f1Id);
        }

        async function loadMoreF2(f1Id) {
            const listWrap = document.getElementById(`f2-list-${f1Id}`);
            const loadMoreWrap = document.getElementById(`f2-loadmore-wrap-${f1Id}`);
            const limit = 20;
            const currentOffset = f1Offsets[f1Id] || 0;

            try {
                // API Load More F2
                const response = await fetch(`/staff/api/team-members?leader_id=${f1Id}&limit=${limit}&offset=${currentOffset}`);
                const result = await response.json();

                if (currentOffset === 0) listWrap.innerHTML = '';

                if (result.success && result.members.length > 0) {
                    let html = '';
                    result.members.forEach(member => {
                        const avatar = member.avatar_url || '/img/default-avatar.png';
                        html += `
                            <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center justify-between hover:border-indigo-300 transition-colors animate-[fadeIn_0.3s_ease-out]">
                                <div class="flex items-center gap-3">
                                    <img src="${avatar}" class="w-8 h-8 rounded-full object-cover">
                                    <div>
                                        <h5 class="text-sm font-bold text-slate-700">${member.full_name}</h5>
                                        <p class="text-[10px] text-slate-500 uppercase tracking-wider">${member.work_status}</p>
                                    </div>
                                </div>
                                <button onclick="openKpiHistoryModal('${member.id}')" class="px-2 py-1 bg-slate-100 text-slate-600 hover:bg-indigo-500 hover:text-white rounded text-[10px] font-bold transition-colors">
                                    <i class="bi bi-clock-history"></i> Xem Điểm
                                </button>
                            </div>
                        `;
                    });
                    
                    listWrap.insertAdjacentHTML('beforeend', html);
                    f1Offsets[f1Id] += limit;

                    if (result.members.length === limit) {
                        loadMoreWrap.classList.remove('hidden');
                    } else {
                        loadMoreWrap.classList.add('hidden');
                    }
                } else {
                    if (currentOffset === 0) {
                        listWrap.innerHTML = '<div class="text-center py-4 text-xs font-bold text-slate-400">Trưởng nhóm này chưa có tuyến dưới.</div>';
                    }
                    loadMoreWrap.classList.add('hidden');
                }
            } catch (error) {
                listWrap.innerHTML = '<div class="text-center py-4 text-xs font-bold text-rose-500">Đang cập nhật tính năng.</div>';
            }
        }

        // 4. MODAL LỊCH SỬ KPI
        async function openKpiHistoryModal(staffId) {
            document.getElementById('kpiHistoryModal').classList.remove('hidden');
            const container = document.getElementById('kpiTimelineContainer');
            container.innerHTML = '<div class="text-center text-slate-400 py-10"><i class="bi bi-arrow-repeat animate-spin text-2xl"></i><p class="mt-2 font-bold uppercase tracking-widest text-xs">Đang tải dữ liệu...</p></div>';

            try {
                const response = await fetch(`/staff/api/kpi/history?staff_id=${staffId}`);
                const result = await response.json();

                if (result.success && result.logs.length > 0) {
                    let html = '<div class="relative border-l-2 border-indigo-100 ml-4 space-y-6 pb-4">';
                    result.logs.forEach(log => {
                        const isPositive = parseFloat(log.points_changed) > 0;
                        const pointClass = isPositive ? 'text-emerald-600 bg-emerald-100 border-emerald-200' : 'text-rose-600 bg-rose-100 border-rose-200';
                        const iconClass = isPositive ? 'bi-arrow-up-right text-emerald-500 bg-emerald-50' : 'bi-arrow-down-right text-rose-500 bg-rose-50';
                        const sign = isPositive ? '+' : '';
                        
                        const dateObj = new Date(log.created_at);
                        const timeStr = dateObj.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                        const dateStr = dateObj.toLocaleDateString('vi-VN');

                        html += `
                            <div class="relative pl-6">
                                <div class="absolute -left-[17px] top-1 w-8 h-8 rounded-full ${iconClass} border-4 border-white shadow-sm flex items-center justify-center text-sm z-10"><i class="bi ${iconClass.split(' ')[0]}"></i></div>
                                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 hover:border-indigo-200 transition-colors">
                                    <div class="flex justify-between items-start mb-2">
                                        <div class="flex items-center gap-2">
                                            <div class="w-2 h-2 rounded-full ${isPositive ? 'bg-emerald-500' : 'bg-rose-500'}"></div>
                                            <span class="font-bold text-slate-700 text-sm">${log.action_type}</span>
                                        </div>
                                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">
                                            ${timeStr} <br> ${dateStr}
                                        </div>
                                    </div>
                                    <div class="flex justify-between items-center gap-4 mt-3">
                                        <div class="text-xs text-slate-500 flex-1">
                                            <i class="bi bi-info-circle text-slate-400 mr-1"></i> ${log.reason || 'Cập nhật hệ thống'}
                                        </div>
                                        <div class="shrink-0 px-3 py-1.5 rounded-xl border ${pointClass} font-black text-sm shadow-sm">
                                            ${sign}${log.points_changed}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = `
                        <div class="text-center text-slate-400 py-12 bg-white rounded-2xl border border-slate-100 border-dashed">
                            <i class="bi bi-inbox text-4xl mb-3 block text-slate-300"></i> 
                            <span class="font-bold text-sm">Chưa có dữ liệu KPI</span>
                            <p class="text-xs mt-1">Nhân sự này chưa có biến động điểm nào được ghi nhận.</p>
                        </div>`;
                }
            } catch (error) {
                container.innerHTML = '<div class="text-center text-rose-500 py-10 font-bold"><i class="bi bi-exclamation-triangle text-2xl mb-2 block"></i> Lỗi kết nối máy chủ!</div>';
            }
        }
    </script>
</body>
</html>