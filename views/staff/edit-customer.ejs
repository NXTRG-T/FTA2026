<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa Thông Tin Khách - FTA CRM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    
    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex items-center gap-3 md:gap-4">
            <a href="/staff/customers" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider hidden md:block">Trở lại</span>
            </a>
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Sửa Thông Tin</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-person-badge-fill text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate"><%= cust.full_name %></span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        
        <form action="/staff/customers/edit/<%= cust.id %>" method="POST" class="bg-white p-6 md:p-8 rounded-[2rem] shadow-[0_2px_20px_rgba(0,0,0,0.03)] border border-slate-100">
            
            <h3 class="text-lg font-black text-slate-800 uppercase tracking-tight mb-6 flex items-center gap-2">
                <i class="bi bi-person-vcard text-teal-500"></i> Hồ sơ cá nhân
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Họ và tên *</label>
                    <input type="text" name="full_name" value="<%= cust.full_name %>" required class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold">
                </div>
                
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Giới tính</label>
                    <select name="gender" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold text-sm appearance-none cursor-pointer">
                        <option value="Nam" <%= cust.gender === 'Nam' ? 'selected' : '' %>>Nam</option>
                        <option value="Nữ" <%= cust.gender === 'Nữ' ? 'selected' : '' %>>Nữ</option>
                        <option value="Chưa xác định" <%= !cust.gender || cust.gender === 'Chưa xác định' ? 'selected' : '' %>>Chưa xác định</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Ngày sinh</label>
                    <input type="date" name="birthday" value="<%= cust.birthday ? new Date(cust.birthday.getTime() - (cust.birthday.getTimezoneOffset() * 60000)).toISOString().split('T')[0] : '' %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold text-sm">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Số điện thoại 1 *</label>
                    <input type="text" name="phone_1" value="<%= cust.phone_1 %>" required class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Số điện thoại 2</label>
                    <input type="text" name="phone_2" value="<%= cust.phone_2 %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold placeholder:text-slate-300" placeholder="Không bắt buộc">
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Email</label>
                    <input type="email" name="email" value="<%= cust.email %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold placeholder:text-slate-300" placeholder="Ví dụ: nguyenvan.a@gmail.com">
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Địa chỉ 1</label>
                    <input type="text" name="address_1" value="<%= cust.address_1 %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold">
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Địa chỉ 2</label>
                    <input type="text" name="address_2" value="<%= cust.address_2 %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-teal-400 focus:ring-4 focus:ring-teal-400/10 outline-none transition-all font-bold placeholder:text-slate-300" placeholder="Không bắt buộc">
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-slate-100">
                <button type="submit" class="flex-1 py-4 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-black text-sm uppercase tracking-widest transition-all shadow-lg shadow-teal-600/20 active:scale-95 flex justify-center items-center gap-2 order-1 sm:order-2">
                    <i class="bi bi-check-circle-fill"></i> Lưu Thay Đổi
                </button>
                <a href="/staff/customers" class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl font-black text-sm uppercase tracking-widest transition-all flex justify-center items-center gap-2 order-2 sm:order-1 active:scale-95">
                    <i class="bi bi-x-circle-fill"></i> Hủy Bỏ
                </a>
            </div>
        </form>

    </div>
</body>
</html>