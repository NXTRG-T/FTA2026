<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ sơ Khách hàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .card-custom { border-radius: 2.5rem; border: 1px solid rgba(226, 232, 240, 0.8); transition: all 0.3s ease; }
        .card-custom:hover { box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); }
        .timeline-line::before { content: ''; position: absolute; left: 20px; top: 0; bottom: 0; width: 2px; background: #e2e8f0; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>

<body class="text-slate-800 pb-10">

    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-[1400px] mx-auto flex items-center gap-3 md:gap-4">
            <a href="/staff/customers" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider block">Trở lại</span>
            </a>

            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Chi tiết khách hàng</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-person-badge-fill text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">
                        <%= customer.full_name %>
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-[1400px] mx-auto p-4 md:p-6 lg:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <div class="lg:col-span-4 space-y-6">
                <div class="card-custom bg-white p-6 md:p-8 shadow-sm relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-teal-50 rounded-full blur-3xl opacity-50"></div>

                    <div class="relative z-10 flex flex-col items-center text-center">
                        <div class="w-24 h-24 bg-gradient-to-tr from-indigo-500 to-cyan-400 text-white rounded-[2rem] flex items-center justify-center text-4xl font-black shadow-xl shadow-indigo-200 mb-5">
                            <%= customer.full_name.charAt(0).toUpperCase() %>
                        </div>
                        <h2 class="text-2xl font-black text-slate-900 mb-2 leading-tight"><%= customer.full_name %></h2>
                        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-100 mb-8">
                            <i class="bi bi-circle-fill text-[8px] animate-pulse"></i> Đang chăm sóc
                        </span>

                        <div class="grid grid-cols-2 gap-3 w-full mb-8">
                            <a href="tel:<%= customer.phone_1 %>" class="bg-indigo-600 hover:bg-indigo-700 text-white py-3.5 rounded-2xl font-black text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-indigo-200 flex justify-center items-center gap-2">
                                <i class="bi bi-telephone-outbound-fill"></i> Gọi ngay
                            </a>
                            <a href="https://zalo.me/<%= customer.phone_1 %>" target="_blank" class="bg-sky-500 hover:bg-sky-600 text-white py-3.5 rounded-2xl font-black text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-sky-200 flex justify-center items-center gap-2">
                                <i class="bi bi-chat-fill"></i> Zalo
                            </a>
                        </div>

                        <!-- Khối thông tin chi tiết đầy đủ -->
                        <div class="w-full text-left bg-slate-50 p-5 rounded-2xl border border-slate-100 mb-2 mt-4">
                            <h3 class="text-sm font-black text-slate-800 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <i class="bi bi-person-lines-fill text-teal-600 text-lg"></i> Thông tin cá nhân
                            </h3>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 gap-x-4">
                                <!-- Họ và tên -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Họ và tên</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.full_name || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Giới tính -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Giới tính</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.gender || 'Chưa xác định' %></span>
                                </div>
                                
                                <!-- Ngày sinh -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Ngày sinh</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.birthday ? formatDateTime(customer.birthday).split(' ')[0] : 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Số CCCD -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Số Căn Cước (CCCD)</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.cccd || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Số điện thoại 1 -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Số điện thoại 1</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.phone_1 || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Số điện thoại 2 -->
                                <div class="flex flex-col gap-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Số điện thoại 2</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.phone_2 || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Email -->
                                <div class="flex flex-col gap-1 sm:col-span-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Email</span>
                                    <span class="text-sm font-bold text-slate-800 break-all"><%= customer.email || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Địa chỉ 1 -->
                                <div class="flex flex-col gap-1 sm:col-span-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Địa chỉ hiện tại</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.address_1 || 'Đang cập nhật' %></span>
                                </div>
                                
                                <!-- Địa chỉ 2 -->
                                <div class="flex flex-col gap-1 sm:col-span-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Địa chỉ phụ</span>
                                    <span class="text-sm font-bold text-slate-800"><%= customer.address_2 || 'Đang cập nhật' %></span>
                                </div>
                            </div>
                        </div>

                        <a href="/staff/customers/edit/<%= customer.id %>" class="w-full mt-4 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-black text-[10px] uppercase tracking-[0.2em] transition-all active:scale-95 flex justify-center items-center gap-2">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa hồ sơ
                        </a>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-8 space-y-8">
                <div class="card-custom bg-white p-6 md:p-8 shadow-sm">
                    <h3 class="font-black text-lg mb-8 flex items-center gap-3 text-slate-800 uppercase tracking-tight">
                        <i class="bi bi-chat-square-text-fill text-teal-600"></i> Cập nhật tương tác mới
                    </h3>

                    <form id="noteForm" action="/staff/customers/<%= customer.id %>/notes" method="POST" class="space-y-6">
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                            <label class="cursor-pointer group">
                                <input type="radio" name="note_type" value="call" class="peer sr-only" checked>
                                <div class="py-4 px-2 text-center rounded-[1.5rem] border-2 border-slate-100 peer-checked:bg-blue-50 peer-checked:border-blue-500 peer-checked:text-blue-600 text-slate-400 transition-all active:scale-95">
                                    <i class="bi bi-telephone-outbound-fill text-2xl block mb-2 group-hover:scale-110 transition-transform"></i>
                                    <span class="text-[10px] font-black uppercase tracking-widest">Gọi điện</span>
                                </div>
                            </label>
                            <label class="cursor-pointer group">
                                <input type="radio" name="note_type" value="meeting" class="peer sr-only">
                                <div class="py-4 px-2 text-center rounded-[1.5rem] border-2 border-slate-100 peer-checked:bg-amber-50 peer-checked:border-amber-500 peer-checked:text-amber-600 text-slate-400 transition-all active:scale-95">
                                    <i class="bi bi-cup-hot-fill text-2xl block mb-2 group-hover:scale-110 transition-transform"></i>
                                    <span class="text-[10px] font-black uppercase tracking-widest">Gặp mặt</span>
                                </div>
                            </label>
                            <label class="cursor-pointer group">
                                <input type="radio" name="note_type" value="message" class="peer sr-only">
                                <div class="py-4 px-2 text-center rounded-[1.5rem] border-2 border-slate-100 peer-checked:bg-emerald-50 peer-checked:border-emerald-500 peer-checked:text-emerald-600 text-slate-400 transition-all active:scale-95">
                                    <i class="bi bi-chat-dots-fill text-2xl block mb-2 group-hover:scale-110 transition-transform"></i>
                                    <span class="text-[10px] font-black uppercase tracking-widest">Nhắn tin</span>
                                </div>
                            </label>
                            <label class="cursor-pointer group">
                                <input type="radio" name="note_type" value="general" class="peer sr-only">
                                <div class="py-4 px-2 text-center rounded-[1.5rem] border-2 border-slate-100 peer-checked:bg-purple-50 peer-checked:border-purple-500 peer-checked:text-purple-600 text-slate-400 transition-all active:scale-95">
                                    <i class="bi bi-pin-angle-fill text-2xl block mb-2 group-hover:scale-110 transition-transform"></i>
                                    <span class="text-[10px] font-black uppercase tracking-widest">Ghi chú</span>
                                </div>
                            </label>
                        </div>

                        <textarea name="content" required rows="4" placeholder="Nhập chi tiết nội dung cuộc trò chuyện, thói quen hoặc ghi chú quan trọng..." class="w-full p-5 bg-slate-50 border border-slate-200 rounded-[2rem] text-sm font-medium text-slate-800 focus:outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10 transition-all shadow-inner"></textarea>

                        <div class="flex flex-col md:flex-row items-center gap-4 justify-between pt-2">
                            <div class="w-full md:w-auto relative group">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-rose-500"><i class="bi bi-alarm-fill"></i></div>
                                <input type="datetime-local" name="reminder_time" class="w-full md:w-auto pl-10 pr-4 py-4 bg-rose-50 border border-rose-100 rounded-2xl text-rose-700 text-xs font-black focus:outline-none focus:ring-4 focus:ring-rose-100 transition-all cursor-pointer">
                                <div class="absolute -top-2 left-4 bg-white px-2 text-[8px] font-black uppercase tracking-[0.2em] text-rose-400">Hẹn nhắc lại</div>
                            </div>

                            <button type="submit" class="w-full md:w-auto px-12 py-4 bg-teal-600 text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-teal-600/20 hover:bg-teal-700 active:scale-95 transition-all flex items-center justify-center gap-3">
                                Lưu Nhật Ký <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-custom bg-white p-6 md:p-8 shadow-sm flex flex-col">
                    <div class="flex items-center justify-between mb-10 border-b border-slate-100 pb-5">
                        <h3 class="font-black text-lg flex items-center gap-3 text-slate-800 uppercase tracking-tight">
                            <i class="bi bi-clock-history text-slate-400"></i> Lịch sử tương tác
                        </h3>
                        <span class="px-4 py-1.5 bg-slate-100 text-slate-500 rounded-full text-[10px] font-black uppercase tracking-widest">
                            <%= notes.length %> Bản ghi
                        </span>
                    </div>

                    <div id="timelineContainer" class="relative ml-2 space-y-10 timeline-line">
                        <% if (notes.length === 0) { %>
                            <div id="empty-msg" class="text-center py-16 opacity-40">
                                <i class="bi bi-journal-x text-5xl block mb-4"></i>
                                <p class="font-bold">Chưa có lịch sử chăm sóc.</p>
                            </div>
                        <% } else { %>
                            <% notes.forEach(note => { 
                                let config = { bg: 'bg-slate-100', text: 'text-slate-500', icon: 'bi-pin-angle-fill' };
                                if(note.note_type==='call') config = { bg: 'bg-blue-500', text: 'text-white', icon: 'bi-telephone-fill' };
                                else if(note.note_type==='meeting') config = { bg: 'bg-amber-500', text: 'text-white', icon: 'bi-cup-hot-fill' };
                                else if(note.note_type==='message') config = { bg: 'bg-emerald-500', text: 'text-white', icon: 'bi-chat-dots-fill' };
                            %>
                                <div class="relative pl-12 group">
                                    <div class="absolute left-0 top-0 w-10 h-10 <%= config.bg %> <%= config.text %> rounded-2xl flex items-center justify-center text-lg shadow-lg ring-4 ring-white z-10 transition-transform group-hover:scale-110">
                                        <i class="bi <%= config.icon %>"></i>
                                    </div>
                                    <div class="bg-slate-50/50 rounded-[1.5rem] p-5 border border-slate-100 hover:border-indigo-200 hover:bg-white hover:shadow-md transition-all duration-300">
                                        <div class="flex justify-between items-start mb-3">
                                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                                <%= new Date(note.created_at).toLocaleString('vi-VN', { hour: '2-digit', minute:'2-digit', day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                        <p class="text-sm text-slate-700 font-medium leading-relaxed whitespace-pre-line m-0"><%= note.content %></p>

                                        <% if (note.reminder_time) { %>
                                            <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 bg-white text-rose-500 rounded-xl text-[10px] font-black uppercase tracking-widest border border-rose-100 shadow-sm">
                                                <i class="bi bi-alarm-fill animate-pulse"></i> Hẹn lại: <%= new Date(note.reminder_time).toLocaleString('vi-VN', { hour: '2-digit', minute:'2-digit', day: '2-digit', month: '2-digit' }) %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL ADD ACTIVE -->
    <div id="activeModal" class="fixed inset-0 z-[100] hidden">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeActiveModal()"></div>
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-[2rem] shadow-2xl p-6 md:p-8 animate-[slideDown_0.3s_ease-out]">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-black text-slate-800"><i class="bi bi-patch-check-fill text-emerald-500 mr-2"></i> Xác nhận Active</h3>
                <button onclick="closeActiveModal()" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>

            <form id="formAddActive" class="space-y-4">
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Mã Active (Bắt buộc Unique) *</label>
                    <input type="text" name="active_code" required placeholder="VD: ACT-KH01-2026" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-emerald-400 outline-none transition-all font-bold text-slate-800 text-sm">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Ngày xác nhận *</label>
                    <input type="datetime-local" name="active_date" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-emerald-400 outline-none transition-all font-bold text-slate-800 text-sm">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Ghi chú chiến dịch</label>
                    <textarea name="notes" rows="2" placeholder="Lý do hoặc tên chiến dịch..." class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-emerald-400 outline-none transition-all font-bold text-slate-800 text-sm resize-none"></textarea>
                </div>
                
                <button type="submit" id="btnSubmitActive" class="w-full py-4 mt-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest transition-all shadow-lg shadow-emerald-200 active:scale-95 flex justify-center items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> LƯU & TÍNH ĐIỂM
                </button>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('noteForm');
            if (!form) return;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                const btnSubmit = form.querySelector('button[type="submit"]');
                const originalBtnText = btnSubmit.innerHTML;

                btnSubmit.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> Đang lưu...';
                btnSubmit.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if (result.success) {
                        const emptyMsg = document.getElementById('empty-msg');
                        if (emptyMsg) emptyMsg.remove();

                        let config = { bg: 'bg-slate-100', text: 'text-slate-500', icon: 'bi-pin-angle-fill' };
                        if(result.note.note_type==='call') config = { bg: 'bg-blue-500', text: 'text-white', icon: 'bi-telephone-fill' };
                        else if(result.note.note_type==='meeting') config = { bg: 'bg-amber-500', text: 'text-white', icon: 'bi-cup-hot-fill' };
                        else if(result.note.note_type==='message') config = { bg: 'bg-emerald-500', text: 'text-white', icon: 'bi-chat-dots-fill' };

                        let reminderHtml = '';
                        if (result.note.reminder_time) {
                            const remDate = new Date(result.note.reminder_time).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
                            reminderHtml = `<div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 bg-white text-rose-500 rounded-xl text-[10px] font-black uppercase tracking-widest border border-rose-100 shadow-sm"><i class="bi bi-alarm-fill animate-pulse"></i> Hẹn lại: ${remDate}</div>`;
                        }

                        const newNoteHTML = `
                            <div class="relative pl-12 transition-all duration-500 animate-[slideDown_0.4s_ease-out]">
                                <div class="absolute left-0 top-0 w-10 h-10 ${config.bg} ${config.text} rounded-2xl flex items-center justify-center text-lg shadow-lg ring-4 ring-white z-10"><i class="bi ${config.icon}"></i></div>
                                <div class="bg-indigo-50/50 rounded-[1.5rem] p-5 border border-indigo-200 shadow-sm">
                                    <div class="flex justify-between items-start mb-3"><span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest">VỪA XONG</span></div>
                                    <p class="text-sm text-slate-800 font-medium leading-relaxed whitespace-pre-line m-0">${result.note.content}</p>
                                    ${reminderHtml}
                                </div>
                            </div>
                        `;
                        document.getElementById('timelineContainer').insertAdjacentHTML('afterbegin', newNoteHTML);
                        form.reset();
                        form.querySelector('input[value="call"]').checked = true;
                    } else { alert('Lưu thất bại: ' + result.message); }
                } catch (error) { alert('Không thể kết nối với máy chủ!'); } 
                finally { btnSubmit.innerHTML = originalBtnText; btnSubmit.disabled = false; }
            });
        });
    </script>
    <style>
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    </style>

    <script>
        // Set thời gian mặc định cho input datetime-local là hiện tại
        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const dateInput = document.querySelector('input[name="active_date"]');
            if (dateInput) dateInput.value = now.toISOString().slice(0, 16);
        });

        // Hàm Mở/Đóng Modal
        function openActiveModal() {
            document.getElementById('activeModal').classList.remove('hidden');
        }
        function closeActiveModal() {
            document.getElementById('activeModal').classList.add('hidden');
            document.getElementById('formAddActive').reset();
        }

        // XỬ LÝ SUBMIT FORM ADD ACTIVE
        const formAddActive = document.getElementById('formAddActive');
        if (formAddActive) {
            formAddActive.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btnSubmitActive');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> Đang xử lý...';
                btn.disabled = true;

                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                data.customer_id = '<%= customer.id %>';

                try {
                    const response = await fetch('/staff/customers/<%= customer.id %>/active', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Tạo mã Active và cộng điểm KPI thành công!');
                        location.reload(); 
                    } else {
                        alert('🛑 Lỗi: ' + result.message);
                    }
                } catch (error) {
                    alert('Không thể kết nối đến máy chủ!');
                } finally {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }

        // XỬ LÝ XÓA ACTIVE (SOFT DELETE & TRỪ ĐIỂM HỒI TỐ)
        async function deleteActiveRecord(activeId) {
            if(!confirm('⚠️ CẢNH BÁO: Hành động này sẽ Hủy trạng thái Active và TỰ ĐỘNG TRỪ ĐIỂM KPI hồi tố của nhân viên. Bạn chắc chắn chứ?')) return;

            try {
                const response = await fetch(`/staff/customers/active/${activeId}/delete`, {
                    method: 'POST' 
                });
                
                const result = await response.json();
                
                if (result.success) {
                    const row = document.getElementById(`active-row-${activeId}`);
                    if (row) {
                        row.style.transition = "opacity 0.3s ease";
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                alert('Lỗi kết nối máy chủ!');
            }
        }
    </script>
</body>
</html>