        </div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] m-0">
            © <%= new Date().getFullYear() %> BRICS VIETNAM. Nền tảng công nghệ dành riêng cho FTA.
        </p>
    </footer>

    <script>
        document.addEventListener('mousemove', (e) => {
            const cursor = document.getElementById('cursor-glow');
            if(cursor) {
                cursor.style.opacity = '1';
                // RequestAnimationFrame giúp hiệu ứng mượt mà hơn và không giật lag
                requestAnimationFrame(() => {
                    cursor.style.transform = `translate(calc(${e.clientX}px - 50%), calc(${e.clientY}px - 50%))`;
                });
            }
        });
    </script>
</body>

</html>