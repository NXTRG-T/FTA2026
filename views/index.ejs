                </div>

                <button type="submit" id="btnSubmitApply"
                    class="w-full py-4 mt-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white rounded-2xl font-black text-sm uppercase tracking-widest transition-all shadow-lg shadow-emerald-200 active:scale-95">
                    GỬI HỒ SƠ ỨNG TUYỂN
                </button>
            </form>
        </div>
    </div>
    <script>
        AOS.init({
            once: true,
            offset: 50,
            duration: 800,
            easing: 'ease-out-cubic',
        });

        // 2. Navbar Background & Highlight Section
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");

        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.classList.add('shadow-[0_4px_30px_rgba(0,0,0,0.5)]');
                nav.style.background = 'rgba(15, 23, 42, 0.85)';
            } else {
                nav.classList.remove('shadow-[0_4px_30px_rgba(0,0,0,0.5)]');
                nav.style.background = 'rgba(15, 23, 42, 0.6)';
            }

            // Highlight Logic
            let current = "";
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (scrollY >= (sectionTop - sectionHeight / 3)) {
                    current = section.getAttribute("id");
                }
            });

            navLinks.forEach(link => {
                link.classList.remove("active");
                if (link.getAttribute("href") === `#${current}`) {
                    link.classList.add("active");
                }
            });
        });

        // 3. Hiệu ứng Parallax nhẹ ở Hero
        document.addEventListener("mousemove", (e) => {
            const x = (e.clientX / window.innerWidth - 0.5) * 20;
            const y = (e.clientY / window.innerHeight - 0.5) * 20;

            document.querySelectorAll(".parallax-layer").forEach(el => {
                const speed = el.getAttribute('data-speed') || 1;
                el.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
            });
        });

        // ==============================================
        // SCRIPT XỬ LÝ MODAL VÀ FORM ỨNG TUYỂN
        // ==============================================

        // 1. Hàm Mở / Đóng Modal
        function openApplyModal() {
            document.getElementById('applyModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Khóa cuộn trang khi mở popup
        }

        function closeApplyModal() {
            document.getElementById('applyModal').classList.add('hidden');
            document.body.style.overflow = 'auto'; // Mở lại cuộn trang
        }

        // 2. Tự động bắt mã giới thiệu (Referral Code) từ Link
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const refCode = urlParams.get('ref');
            if (refCode) {
                document.getElementById('referral_code').value = refCode;
                // Nếu có mã giới thiệu -> Tự động bật Form luôn cho ứng viên điền
                openApplyModal();
            }
        });

        // Biến trạng thái kiểm tra xem có đang upload không
        let isSubmitting = false;

        // Cảnh báo nếu người dùng cố tình đóng tab/F5 khi đang upload
        window.addEventListener('beforeunload', function (e) {
            if (isSubmitting) {
                e.preventDefault();
                e.returnValue = 'Hồ sơ của bạn đang được tải lên, bạn có chắc chắn muốn thoát không?';
            }
        });

        // 3. Xử lý Gửi Form bằng AJAX
        document.getElementById('formApply').addEventListener('submit', async function (e) {
            e.preventDefault();
            isSubmitting = true; // Khóa cảnh báo
            const btn = document.getElementById('btnSubmitApply');
            btn.innerHTML = 'ĐANG XỬ LÝ...';
            btn.disabled = true;

            const formData = new FormData(this);

            try {
                // Developer nhớ khai báo Route này trong file routes.js nhé
                const response = await fetch('/api/recruitment/apply', {
                    method: 'POST',
                    body: formData // Truyền nguyên formData để gửi kèm File CV
                });

                // Kiểm tra nếu server trả về lỗi (như 404, 500)
                if (!response.ok) {
                    throw new Error('Lỗi máy chủ: ' + response.status);
                }

                const result = await response.json();

                if (result.success) {
                    alert('🎉 Cảm ơn bạn! Hồ sơ đã được gửi thành công. Chúng tôi sẽ liên hệ sớm nhất.');
                    this.reset();
                    closeApplyModal();
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                console.error(error);
                alert('Lỗi kết nối máy chủ! Vui lòng thử lại sau.');
            } finally {
                isSubmitting = false; // Gỡ khóa cảnh báo khi xong
                btn.innerHTML = 'GỬI HỒ SƠ ỨNG TUYỂN';
                btn.disabled = false;
            }
        });
    </script>
</body>

</html>