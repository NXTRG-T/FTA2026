        </div>
    </nav>

    <section class="pt-32 md:pt-40 pb-20 px-6 relative z-10">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative">

            <div class="space-y-6 text-center lg:text-left relative z-10">
