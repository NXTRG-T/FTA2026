                <div class="lg:col-span-3 bg-gradient-to-r from-amber-400 via-orange-500 to-rose-500 rounded-[2.5rem] p-8 md:p-10 shadow-2xl shadow-orange-500/20 text-white relative overflow-hidden hover:-translate-y-2 transition-all duration-300 group">
