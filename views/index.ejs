                    <span class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-indigo-500"></span>
                    </span>
                    HOT: Đang mở đơn tuyển dụng tháng <%= new Date().getMonth() + 1 %> <i class="bi bi-arrow-right-short text-lg ml-1 group-hover:translate-x-1 transition-transform"></i>
                </a>

                <h1 class="text-5xl md:text-6xl lg:text-[72px] font-black leading-[1.05] tracking-tight text-slate-900">
                    Sự nghiệp vững vàng <br>
                    <span class="text-gradient">Thu nhập bứt phá</span>
                </h1>

                <p class="text-lg text-slate-500 font-medium leading-relaxed max-w-lg mx-auto lg:mx-0">
                    Đừng chỉ tìm một công việc, hãy xây dựng một sự nghiệp. Trở thành Chuyên viên tại BRICS với bệ phóng công nghệ FTA chuyên nghiệp và đãi ngộ vượt trội.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                    <a href="#apply" class="px-10 py-4 bg-indigo-600 text-white rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-indigo-600/30 hover:bg-indigo-700 hover:-translate-y-1 transition-all text-center flex items-center justify-center gap-2">
                        <i class="bi bi-rocket-takeoff-fill"></i> Ứng tuyển ngay
                    </a>
                </div>

                <div class="flex items-center gap-4 pt-6 justify-center lg:justify-start">
                    <div class="flex -space-x-3">
                        <img src="https://i.pravatar.cc/100?img=32" class="w-10 h-10 rounded-full border-2 border-white shadow-sm" alt="User">
                        <img src="https://i.pravatar.cc/100?img=12" class="w-10 h-10 rounded-full border-2 border-white shadow-sm" alt="User">
                        <img src="https://i.pravatar.cc/100?img=5" class="w-10 h-10 rounded-full border-2 border-white shadow-sm" alt="User">
                        <div class="w-10 h-10 rounded-full border-2 border-white shadow-sm bg-indigo-50 flex items-center justify-center text-[10px] font-black text-indigo-600">+1k</div>
                    </div>
                    <div>
                        <div class="flex text-amber-400 text-xs mb-0.5">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-600 m-0">Hơn <span class="text-indigo-600">1.200+</span> nhân sự đã gia nhập</p>
                    </div>
                </div>
            </div>

            <div class="relative hidden lg:block mt-8 lg:mt-0">
                <div class="animate-float relative z-10">
                    <div class="bg-white/60 backdrop-blur-2xl border border-white p-4 rounded-[3.5rem] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)] relative group">
                        <img src="\public\uploads\system\dashboard_banner-1774196774052.webp" alt="Dashboard Preview" class="rounded-[2.5rem] shadow-inner transition-transform duration-500 group-hover:scale-[1.02]">

                        <div class="absolute -bottom-8 -left-8 bg-white/90 backdrop-blur-xl p-5 rounded-[2rem] shadow-2xl border border-white flex items-center gap-4 animate-[float_4s_ease-in-out_infinite_reverse]">
                            <div class="w-14 h-14 bg-gradient-to-tr from-emerald-400 to-teal-400 text-white rounded-[1.2rem] flex items-center justify-center shadow-lg shadow-emerald-200">
                                <span class="text-4xl font-black mb-1">∞</span>
                            </div>
                            <div class="pr-2">
