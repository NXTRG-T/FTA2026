<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BRICS Việt Nam - Giải Pháp Bảo Hiểm Thông Minh</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .animate-float { animation: float 5s ease-in-out infinite; }
        .glass-nav { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); }
        .text-gradient { background: linear-gradient(to right, #4f46e5, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .bg-aurora { background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.1) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.1) 0%, transparent 40%); }
        
        /* Hiệu ứng Gradient Border khi Hover */
        .hover-gradient-border { position: relative; z-index: 1; }
        .hover-gradient-border::before {
            content: ""; position: absolute; inset: 0; padding: 2px; border-radius: 2rem;
            background: linear-gradient(135deg, #6366f1, #06b6d4, #10b981); 
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity 0.3s ease; z-index: -1;
        }
        .hover-gradient-border:hover::before { opacity: 1; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f8fafc; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        html { scroll-behavior: smooth; }
    </style>
</head>

<body class="bg-slate-50 text-slate-900 overflow-x-hidden bg-aurora relative">

    <div id="cursor-glow" class="fixed w-[500px] h-[500px] bg-indigo-400/20 rounded-full pointer-events-none blur-[120px] -translate-x-1/2 -translate-y-1/2 z-0 transition-opacity duration-300 hidden lg:block opacity-0"></div>

    <nav class="fixed top-0 w-full z-50 glass-nav border-b border-white shadow-[0_4px_30px_rgba(0,0,0,0.02)]">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img src="/img/logo.png" alt="BRICS Logo" class="h-10" onerror="this.src='/img/default-logo.png'">
                <span class="font-black text-xl tracking-tighter text-slate-800">BRICS <span class="text-indigo-600">VIETNAM</span></span>
            </div>
            <div class="hidden md:flex items-center gap-8 text-[11px] font-black uppercase tracking-[0.15em] text-slate-500">
                <a href="#why-brics" class="hover:text-indigo-600 transition-colors">Vì sao chọn BRICS?</a>
                <a href="#job-info" class="hover:text-indigo-600 transition-colors">Tuyển dụng</a>
                <a href="#benefits" class="hover:text-indigo-600 transition-colors">Quyền lợi</a>
            </div>
            <a href="/auth/login" class="px-6 py-2.5 bg-slate-900 text-white rounded-full font-bold text-xs uppercase tracking-widest hover:bg-indigo-600 shadow-lg hover:shadow-indigo-500/30 transition-all active:scale-95 flex items-center gap-2">
                <i class="bi bi-shield-lock-fill"></i> Đăng nhập FTA
