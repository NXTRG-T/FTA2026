<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi Tiết Nhân Viên - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-gray-800 pb-20">

    <div class="max-w-5xl mx-auto p-4 md:p-6 md:pt-8">
        
        <div class="mb-6">
            <a href="/admin/staff-management" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-xl font-bold text-xs uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Trở về nhân sự
            </a>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div>
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-3">
                    <i class="bi bi-person-badge-fill text-indigo-500"></i> <%= staff.full_name %>
                </h2>
                <p class="text-slate-500 font-semibold text-[11px] uppercase tracking-widest mt-1.5 m-0">Quản lý hồ sơ & Lịch sử thao tác</p>
                
            </div>

            <div class="flex items-center gap-2 shrink-0 border-t sm:border-t-0 border-slate-100 pt-4 sm:pt-0">
                <form action="/admin/staff/toggle-lock/<%= staff.id %>" method="POST" class="m-0 w-full sm:w-auto">
                    <input type="hidden" name="is_locked" value="<%= staff.is_locked == 1 ? 0 : 1 %>">
                    <% if(staff.is_locked == 1) { %>
                        <button type="submit" class="w-full px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-black text-xs uppercase tracking-widest transition-all flex justify-center items-center gap-2 shadow-md hover:shadow-lg active:scale-95">
                            <i class="bi bi-unlock-fill text-base"></i> Mở Khóa TK
                        </button>
                    <% } else { %>
                        <input type="hidden" name="lock_message" value="Khóa từ trang chi tiết">
                        <button type="submit" class="w-full px-6 py-3 bg-rose-500 hover:bg-rose-600 text-white rounded-xl font-black text-xs uppercase tracking-widest transition-all flex justify-center items-center gap-2 shadow-md hover:shadow-lg active:scale-95" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này? Nhân viên sẽ bị đăng xuất lập tức.');">
                            <i class="bi bi-lock-fill text-base"></i> Khóa Tài Khoản
                        </button>
                    <% } %>
                </form>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-full">
                <div class="flex justify-between items-center mb-6 pb-4 border-b border-slate-100">
                    <h4 class="text-base font-black text-slate-800 m-0">Trạng thái</h4>
                    <% if(staff.is_locked == 1) { %>
                        <span class="px-3 py-1 bg-rose-100 text-rose-700 font-bold text-[10px] uppercase tracking-widest rounded-full border border-rose-200"><i class="bi bi-lock-fill"></i> Bị Khóa</span>
                    <% } else { %>
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-700 font-bold text-[10px] uppercase tracking-widest rounded-full border border-emerald-200"><i class="bi bi-check-circle-fill"></i> Hoạt động</span>
                    <% } %>
                </div>
                
                <div class="space-y-5">
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">ID Đăng nhập</p>
                        <p class="text-base font-bold text-slate-800 m-0">@<%= staff.username %></p>
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Quyền hạn</p>
                        <p class="text-base font-black text-indigo-600 m-0"><%= staff.role %></p>
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Quản lý tuyển dụng</p>
                        <% if(staff.can_recruit == 1) { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-purple-100 text-purple-700 text-xs font-black uppercase tracking-widest rounded-md border border-purple-200 shadow-sm" title="Được quyền tuyển dụng">🤝 ĐƯỢC CẤP QUYỀN</span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-500 text-xs font-black uppercase tracking-widest rounded-md border border-slate-200 shadow-sm">KHÔNG CÓ QUYỀN</span>
                        <% } %>
                    </div>
                    
                    <% if(staff.is_locked == 1 && staff.lock_message) { %>
                        <div class="mt-4 p-4 bg-rose-50 border border-rose-100 rounded-xl text-sm text-rose-700">
                            <b class="font-black block mb-1 uppercase text-[10px] tracking-widest">Lý do khóa:</b> 
                            <span class="font-medium"><%= staff.lock_message %></span>
                        </div>
                    <% } %>

<button onclick="openKpiHistoryModal('<%= staff.id %>')" class="mt-4 md:mt-0 inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-xl font-bold text-sm uppercase tracking-widest transition-all shadow-sm border border-indigo-100">
    <i class="bi bi-clock-history text-lg"></i> Xem Lịch Sử KPI
</button>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 lg:col-span-2 flex flex-col md:flex-row overflow-hidden">
                
                <div class="p-6 md:p-8 bg-slate-50 border-b md:border-b-0 md:border-r border-slate-100 flex flex-col items-center justify-center shrink-0 md:w-64">
                    <form action="/admin/staff/update-avatar/<%= staff.id %>" method="POST" enctype="multipart/form-data" id="avatarForm">
                        <label for="avatar-upload" class="relative group cursor-pointer w-32 h-32 rounded-full block mb-4">
                            <img id="avatar-preview" src="<%= staff.avatar_url || '/img/default-avatar.png' %>" class="w-full h-full rounded-full object-cover border-4 border-white shadow-md ring-1 ring-slate-200 transition-all">
                            
                            <div class="absolute inset-0 bg-slate-900/60 rounded-full opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white transition-all duration-200 border-4 border-transparent backdrop-blur-sm">
                                <i class="bi bi-camera-fill text-2xl mb-1"></i>
                                <span class="text-[10px] font-black uppercase tracking-widest">Đổi ảnh</span>
                            </div>
                        </label>
                        <input type="file" name="avatar" id="avatar-upload" accept="image/*" class="hidden" onchange="handleAvatarUpload(this)">
                    </form>
                    <h4 class="font-black text-slate-800 text-lg uppercase text-center leading-tight"><%= staff.full_name %></h4>
                </div>

                <div class="p-6 md:p-8 flex-1">
                    <div class="flex justify-between items-center mb-6 pb-4 border-b border-slate-100">
                        <h4 class="text-base font-black text-slate-800 m-0"><i class="bi bi-person-lines-fill text-indigo-400 mr-2"></i>Hồ sơ cá nhân</h4>
                        <a href="/admin/staff-management" class="text-[10px] font-black text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5 uppercase tracking-widest">
                            <i class="bi bi-pencil-square"></i> Cập nhật
                        </a>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-4">
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Số điện thoại</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.phone_1 || 'Chưa cập nhật' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Email</p>
                            <p class="text-base font-bold text-slate-800 m-0 truncate" title="<%= staff.email %>"><%= staff.email || '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Giới tính</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.gender || 'Chưa xác định' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Mã NV (MSKD)</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.business_code || '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Khu vực</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.work_area || '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">CCCD</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.cccd || '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">BĐ Thử việc</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.probation_start_date ? new Date(staff.probation_start_date).toLocaleDateString('vi-VN') : '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">KT Thử việc</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.probation_end_date ? new Date(staff.probation_end_date).toLocaleDateString('vi-VN') : '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">BĐ Chính thức</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.start_date ? new Date(staff.start_date).toLocaleDateString('vi-VN') : '---' %></p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">KT Chính thức</p>
                            <p class="text-base font-bold text-slate-800 m-0"><%= staff.end_date ? new Date(staff.end_date).toLocaleDateString('vi-VN') : '---' %></p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            
            <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/50">
                <div>
                    <h4 class="text-base font-black text-slate-800 m-0 flex items-center gap-2">
                        <i class="bi bi-clock-history text-indigo-500"></i> Lịch Sử Thao Tác
                    </h4>
                    <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-widest mt-1.5 mb-0"><%= logs.length %> bản ghi được lưu</p>
                </div>
                
                <div class="relative">
                    <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="logSearchInput" placeholder="Tìm kiếm hành động..." class="pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none w-full sm:w-64 transition-all shadow-sm placeholder:text-slate-400">
                </div>
            </div>

            <% if(logs.length === 0) { %>
                <div class="text-center py-12">
                    <i class="bi bi-inboxes text-5xl text-slate-200 mb-3 block"></i>
                    <p class="text-slate-500 font-bold text-sm m-0">Chưa có lịch sử hoạt động nào được ghi nhận.</p>
                </div>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead>
                            <tr class="bg-white text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-200">
                                <th class="px-6 py-4">Thời gian</th>
                                <th class="px-6 py-4">Phân loại</th>
                                <th class="px-6 py-4">Chi tiết thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="text-xs text-slate-700 divide-y divide-slate-100" id="logTableBody">
                            <% logs.forEach(log => { 
                                let isSelfAction = log.user_id === staff.id;
                                let rowBg = isSelfAction ? 'hover:bg-slate-50' : 'bg-orange-50/30 hover:bg-orange-50/60';
                                let badgeClass = isSelfAction ? 'bg-slate-100 text-slate-600 border border-slate-200' : 'bg-orange-100 text-orange-700 border border-orange-200';
                            %>
                                <tr class="log-row <%= rowBg %> transition-colors">
                                    <td class="px-6 py-3 font-medium text-slate-500 align-top pt-4">
                                        <%= typeof formatDateTime !== 'undefined' ? formatDateTime(log.created_at) : log.created_at %>
                                        <% if(!isSelfAction) { %>
                                            <br><span class="inline-block mt-1 text-[9px] font-black text-orange-500 uppercase tracking-widest bg-orange-100/50 px-2 py-0.5 rounded">Tác động bởi: <%= log.actor_name %></span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-3 align-top pt-4">
                                        <span class="px-2.5 py-1 rounded-md font-black text-[9px] uppercase tracking-widest shadow-sm <%= badgeClass %>">
                                            <%= log.action_type %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 font-medium text-slate-700 whitespace-normal min-w-[250px] leading-relaxed log-content">
                                        <%= log.content %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="p-4 bg-slate-50 border-t border-slate-100 flex flex-wrap gap-4 sm:gap-8 justify-center sm:justify-start">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-white border border-slate-300 shadow-sm"></span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Tự thao tác</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-orange-100 border border-orange-300 shadow-sm"></span>
                        <span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Admin tác động</span>
                    </div>
                </div>
            <% } %>

        </div>

    </div>

    <script>
        // Xử lý Preview ảnh và Tự động submit
        function handleAvatarUpload(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const maxSizeMB = 5; 
                
                if (file.size > maxSizeMB * 1024 * 1024) {
                    alert(`🛑 LỖI: Ảnh của bạn nặng ${(file.size / (1024*1024)).toFixed(2)}MB. Vui lòng chọn ảnh dưới ${maxSizeMB}MB!`);
                    input.value = '';
                    return;
                }

                // Hiển thị ảnh Preview lập tức
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                }
                reader.readAsDataURL(file);

                // Delay 0.5s để người dùng thấy ảnh xoay xong thì tự submit form
                setTimeout(() => {
                    document.getElementById('avatarForm').submit();
                }, 500);
            }
        }

        // Live Search cho Bảng Log
        const logSearchInput = document.getElementById('logSearchInput');
        if(logSearchInput) {
            logSearchInput.addEventListener('input', function(e) {
                const keyword = e.target.value.toLowerCase();
                const rows = document.querySelectorAll('.log-row');
                
                rows.forEach(row => {
                    // Lọc theo cột chi tiết nội dung log
                    const content = row.querySelector('.log-content').innerText.toLowerCase();
                    if (content.includes(keyword)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }
    </script>
    <div id="kpiHistoryModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col animate-[fadeIn_0.2s_ease-out]">
        <div class="flex justify-between items-center p-6 border-b border-slate-100 shrink-0">
            <h3 class="font-black text-xl text-slate-800 flex items-center gap-2 m-0"><i class="bi bi-journal-text text-indigo-500"></i> Lịch sử biến động KPI</h3>
            <button onclick="document.getElementById('kpiHistoryModal').classList.add('hidden')" class="text-slate-400 hover:text-rose-500 text-3xl leading-none">&times;</button>
        </div>
        
        <div class="p-6 overflow-y-auto bg-slate-50/50 flex-1" id="kpiTimelineContainer">
            </div>
    </div>
</div>

<script>
    async function openKpiHistoryModal(staffId) {
        // Mở modal và hiển thị trạng thái loading
        document.getElementById('kpiHistoryModal').classList.remove('hidden');
        const container = document.getElementById('kpiTimelineContainer');
        container.innerHTML = '<div class="text-center text-slate-400 py-10"><i class="bi bi-arrow-repeat animate-spin text-2xl"></i><p class="mt-2 font-bold uppercase tracking-widest text-xs">Đang tải dữ liệu...</p></div>';

        try {
            // Gọi API phía Admin, truyền kèm staff_id
            const response = await fetch(`/admin/api/kpi/history?staff_id=${staffId}`);
            const result = await response.json();

            if (result.success && result.logs.length > 0) {
                let html = '<div class="relative border-l-2 border-indigo-100 ml-4 space-y-6 pb-4">';
                
                result.logs.forEach(log => {
                    const isPositive = parseFloat(log.points_changed) > 0;
                    const pointClass = isPositive ? 'text-emerald-600 bg-emerald-100 border-emerald-200' : 'text-rose-600 bg-rose-100 border-rose-200';
                    const iconClass = isPositive ? 'bi-arrow-up-right text-emerald-500 bg-emerald-50' : 'bi-arrow-down-right text-rose-500 bg-rose-50';
                    const sign = isPositive ? '+' : '';
                    
                    const dateObj = new Date(log.created_at);
                    const timeStr = dateObj.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                    const dateStr = dateObj.toLocaleDateString('vi-VN');

                    html += `
                        <div class="relative pl-6">
                            <div class="absolute -left-[17px] top-1 w-8 h-8 rounded-full ${iconClass} border-4 border-white shadow-sm flex items-center justify-center text-sm z-10"><i class="bi ${iconClass.split(' ')[0]}"></i></div>
                            
                            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 hover:border-indigo-200 transition-colors">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 rounded-full ${isPositive ? 'bg-emerald-500' : 'bg-rose-500'}"></div>
                                        <span class="font-bold text-slate-700 text-sm">${log.action_type}</span>
                                    </div>
                                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">
                                        ${timeStr} <br> ${dateStr}
                                    </div>
                                </div>
                                <div class="flex justify-between items-center gap-4 mt-3">
                                    <div class="text-xs text-slate-500 flex-1">
                                        <i class="bi bi-info-circle text-slate-400 mr-1"></i> ${log.reason || 'Cập nhật hệ thống'}
                                    </div>
                                    <div class="shrink-0 px-3 py-1.5 rounded-xl border ${pointClass} font-black text-sm shadow-sm">
                                        ${sign}${log.points_changed}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            } else {
                container.innerHTML = `
                    <div class="text-center text-slate-400 py-12 bg-white rounded-2xl border border-slate-100 border-dashed">
                        <i class="bi bi-inbox text-4xl mb-3 block text-slate-300"></i> 
                        <span class="font-bold text-sm">Chưa có dữ liệu KPI</span>
                        <p class="text-xs mt-1">Nhân sự này chưa phát sinh biến động điểm nào.</p>
                    </div>`;
            }
        } catch (error) {
            container.innerHTML = '<div class="text-center text-rose-500 py-10 font-bold"><i class="bi bi-exclamation-triangle text-2xl mb-2 block"></i> Lỗi kết nối máy chủ!</div>';
        }
    }
</script>
</body>
</html>