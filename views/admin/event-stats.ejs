<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo Cáo Sự Kiện</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-gray-800 pb-20">

    <div class="max-w-4xl mx-auto p-4 md:p-6 md:pt-8">
        
        <div class="mb-4">
            <a href="/admin/events" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-orange-400 text-slate-600 hover:text-orange-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Trở về sự kiện
            </a>
        </div>

        <div class="flex flex-col sm:flex-row justify-between gap-4 mb-8 bg-white p-5 md:p-6 rounded-[2rem] shadow-sm border border-slate-200">
            <div>
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex gap-2">
                    <i class="bi bi-bar-chart-fill text-orange-500"></i>
                    <span class="truncate max-w-full"><%= event.event_name %></span>
                </h2>
                <p class="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-2 m-0"><i class="bi bi-clock"></i> <%= formatDateTime(event.start_time) %></p>
            </div>
            <div class="shrink-0 flex items-center">
                 <button onclick="window.print()" class="px-5 py-3 bg-slate-900 text-white hover:bg-orange-600 rounded-xl font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 shadow-lg hover:-translate-y-1">
                    <i class="bi bi-printer-fill text-base"></i> In Báo Cáo
                </button>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-200 border-b-4 border-b-blue-500 text-center flex flex-col items-center justify-center">
                <i class="bi bi-people-fill text-2xl text-blue-400 mb-2"></i>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest m-0">Tổng khách mời</p>
                <h3 class="text-3xl font-black text-slate-800 m-0"><%= stats.total %></h3>
            </div>
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-200 border-b-4 border-b-emerald-500 text-center flex flex-col items-center justify-center">
                <i class="bi bi-check-circle-fill text-2xl text-emerald-400 mb-2"></i>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest m-0">Đã tham dự</p>
                <h3 class="text-3xl font-black text-emerald-600 m-0"><%= stats.attended %></h3>
            </div>
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-200 border-b-4 border-b-rose-500 text-center flex flex-col items-center justify-center">
                <i class="bi bi-x-circle-fill text-2xl text-rose-400 mb-2"></i>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest m-0">Không đến</p>
                <h3 class="text-3xl font-black text-rose-600 m-0"><%= stats.not_attended %></h3>
            </div>
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-200 border-b-4 border-b-amber-500 text-center flex flex-col items-center justify-center">
                <i class="bi bi-question-circle-fill text-2xl text-amber-400 mb-2"></i>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest m-0">Chưa phản hồi</p>
                <h3 class="text-3xl font-black text-amber-600 m-0"><%= stats.pending %></h3>
            </div>
        </div>

        <div class="bg-white p-6 md:p-8 rounded-[2.5rem] shadow-sm border border-slate-200">
            <h4 class="text-lg font-black text-slate-800 mb-6 pb-3 border-b border-slate-100 mt-0 flex justify-between items-center">
                Hiệu suất mời khách
                <span class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest shadow-sm">Theo Nhân Sự</span>
            </h4>
            
            <% if (staff_stats.length === 0) { %>
                <div class="text-center py-8 text-slate-400 font-bold italic">Chưa có dữ liệu nhân viên mời khách cho sự kiện này.</div>
            <% } else { %>
                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-50 text-[10px] font-black text-slate-500 uppercase tracking-widest border-b border-slate-200">
                                <th class="px-6 py-4 pl-8">Nhân viên phụ trách</th>
                                <th class="px-6 py-4 pr-8 text-right">Lượng khách mời</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm text-slate-700 divide-y divide-slate-100">
                            <% staff_stats.forEach(stat => { %>
                                <tr class="hover:bg-orange-50/30 transition-colors">
                                    <td class="px-6 py-4 pl-8 font-black text-slate-800">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center border border-slate-200 shadow-sm"><i class="bi bi-person-fill"></i></div>
                                            <%= stat.staff_name %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 pr-8 text-right">
                                        <span class="inline-block px-4 py-1.5 bg-indigo-50 border border-indigo-100 text-indigo-700 font-black rounded-xl text-xs shadow-sm">
                                            <%= stat.customer_count %> Khách
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>