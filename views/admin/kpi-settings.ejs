<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cấu hình KPI - FTA CRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800 pb-20">

<div class="max-w-5xl mx-auto p-4 md:p-6 md:pt-8">
        <div class="mb-4">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
            <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Dashboard
        </a>
    </div>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-white p-6 rounded-[2.5rem] shadow-sm border border-slate-200">
        <div>
            <!-- <a href="/admin/dashboard" class="inline-flex items-center gap-2 text-slate-400 hover:text-indigo-600 font-black text-[10px] uppercase tracking-widest mb-2 transition-colors"><i class="bi bi-arrow-left"></i> Về Dashboard</a> -->
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                <i class="bi bi-sliders text-indigo-500"></i> Cấu hình Điểm KPI
            </h2>
        </div>
        
        <form method="GET" action="/admin/kpi-settings" class="flex gap-2">
            <select name="month" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl font-black text-sm text-indigo-600 outline-none cursor-pointer" onchange="this.form.submit()">
                <% for(let i=1; i<=12; i++) { %>
                    <option value="<%= i %>" <%= month == i ? 'selected' : '' %>>Tháng <%= i %></option>
                <% } %>
            </select>
            <select name="year" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl font-black text-sm text-indigo-600 outline-none cursor-pointer" onchange="this.form.submit()">
                <option value="2026" <%= year == 2026 ? 'selected' : '' %>>2026</option>
                <option value="2025" <%= year == 2025 ? 'selected' : '' %>>2025</option>
            </select>
        </form>
    </div>

    <% if(config && config.is_locked) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-3xl font-bold flex items-center gap-3 shadow-sm">
            <i class="bi bi-lock-fill text-xl"></i> Tháng này đã được CHỐT SỔ. Dữ liệu điểm số đã đóng băng và không thể sửa đổi cấu hình.
        </div>
    <% } %>

    <form action="/admin/kpi-settings/save" method="POST" class="space-y-6">
        <input type="hidden" name="month" value="<%= month %>">
        <input type="hidden" name="year" value="<%= year %>">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 md:p-8 rounded-[2.5rem] shadow-sm border border-slate-200 border-t-4 border-t-emerald-500">
                <h3 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><i class="bi bi-coin text-emerald-500"></i> Bảng tính Điểm Thưởng</h3>
                
                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Khách Tham Dự Sự Kiện (Điểm/Khách)</label>
                        <input type="number" name="point_event" value="<%= config ? config.point_per_attended_event : 50 %>" <%= config && config.is_locked ? 'readonly' : '' %> class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-5 py-3 font-bold focus:border-emerald-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Hoàn Thành Khảo Sát (Điểm/Phiếu)</label>
                        <input type="number" name="point_survey" value="<%= config ? config.point_per_survey : 10 %>" <%= config && config.is_locked ? 'readonly' : '' %> class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-5 py-3 font-bold focus:border-emerald-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Khách Hàng Mới (Điểm/Hồ sơ)</label>
                        <input type="number" name="point_customer" value="<%= config ? config.point_per_new_customer : 5 %>" <%= config && config.is_locked ? 'readonly' : '' %> class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-5 py-3 font-bold focus:border-emerald-400 outline-none">
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class="bg-white p-6 rounded-[2.5rem] shadow-sm border border-slate-200 border-t-4 border-t-amber-500">
                    <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><i class="bi bi-diagram-3-fill text-amber-500"></i> Cơ chế Trưởng Nhóm</h3>
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Hệ số Quản lý (Ví dụ: 0.1 = 10%)</label>
                    <input type="number" step="0.01" name="tl_coefficient" value="<%= config ? config.tl_coefficient : 0.1 %>" <%= config && config.is_locked ? 'readonly' : '' %> class="w-full bg-slate-50 border-2 border-slate-100 rounded-2xl px-5 py-3 font-bold focus:border-amber-400 outline-none">
                    <p class="text-[10px] text-slate-400 mt-2 font-bold"><i class="bi bi-info-circle"></i> Trưởng nhóm sẽ được cộng thêm điểm bằng [Tổng điểm lính] x [Hệ số].</p>
                </div>

                <div class="bg-white p-6 rounded-[2.5rem] shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between mb-4">
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Hiển thị Bục vinh quang</label>
                        <select name="top_limit" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1 text-sm font-bold outline-none" <%= config && config.is_locked ? 'disabled' : '' %>>
                            <option value="3" <%= config && config.top_display_limit == 3 ? 'selected' : '' %>>Top 3</option>
                            <option value="5" <%= config && config.top_display_limit == 5 ? 'selected' : '' %>>Top 5</option>
                            <option value="10" <%= config && config.top_display_limit == 10 ? 'selected' : '' %>>Top 10</option>
                        </select>
                    </div>
                    
                    <label class="flex items-center gap-3 cursor-pointer p-3 bg-indigo-50 rounded-2xl border border-indigo-100">
                        <input type="checkbox" name="is_published" value="1" <%= config && config.is_published ? 'checked' : '' %> <%= config && config.is_locked ? 'disabled' : '' %> class="w-5 h-5 accent-indigo-600 cursor-pointer">
                        <span class="text-sm font-black text-indigo-900 uppercase tracking-tight">Công khai cho Nhân viên xem</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-[2.5rem] shadow-sm border border-slate-200">
            <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><i class="bi bi-calendar-check-fill text-blue-500"></i> Các Sự kiện được tính điểm trong tháng</h3>
            
            <% if(events.length === 0) { %>
                <p class="text-sm font-bold text-slate-400 italic">Tháng này chưa có sự kiện nào được tạo.</p>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    <% events.forEach(ev => { %>
                        <label class="flex items-center gap-3 p-4 border-2 border-slate-100 rounded-2xl cursor-pointer hover:bg-slate-50 transition-colors <%= config && config.is_locked ? 'opacity-60' : '' %>">
                            <input type="checkbox" name="event_ids" value="<%= ev.id %>" <%= selectedEvents.includes(ev.id) ? 'checked' : '' %> <%= config && config.is_locked ? 'disabled' : '' %> class="w-5 h-5 accent-blue-600">
                            <span class="text-sm font-bold text-slate-700 line-clamp-1"><%= ev.event_name %></span>
                        </label>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <% if(!config || !config.is_locked) { %>
            <button type="submit" class="w-full py-5 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-black rounded-full shadow-xl shadow-indigo-200 text-sm uppercase tracking-widest transition-transform hover:-translate-y-1">Lưu Cấu Hình KPI Tháng <%= month %></button>
        <% } %>
    </form>
</div>
</body>
</html>