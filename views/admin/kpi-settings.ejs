<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý KPI - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .glass-header { background: rgba(13, 148, 136, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
        .card-custom { border-radius: 2.5rem; border: 1px solid rgba(226, 232, 240, 0.8); }
        
        /* Toggle Switch CSS */
        .toggle-checkbox:checked { right: 0; border-color: #10B981; }
        .toggle-checkbox:checked + .toggle-label { background-color: #10B981; }
    </style>
</head>
<body class="text-slate-800 pb-20">

    <nav class="glass-header text-white px-4 py-3 shadow-lg sticky top-0 z-50">
        <div class="max-w-[1400px] mx-auto flex items-center gap-3 md:gap-4">
            <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl transition-all active:scale-95 shrink-0">
                <i class="bi bi-arrow-left text-xl"></i>
                <span class="text-sm font-black uppercase tracking-wider block">Trở lại</span>
            </a>
            <div class="flex items-center gap-2 md:gap-3 flex-1 min-w-0">
                <h1 class="font-black text-sm md:text-xl leading-none truncate shrink-0">Cấu Hình Luật KPI</h1>
                <span class="text-white/40 font-light text-xl">|</span>
                <div class="flex items-center gap-1.5 text-teal-100 min-w-0">
                    <i class="bi bi-sliders text-sm md:text-lg shrink-0"></i>
                    <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest truncate">Thiết lập điểm thưởng</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-[1400px] mx-auto p-4 md:p-6 lg:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <div class="lg:col-span-5 space-y-6">
                <div class="card-custom bg-white p-6 md:p-8 shadow-sm">
                    <h2 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-2">
                        <i class="bi bi-plus-circle-fill text-teal-600"></i> Tạo chiến dịch mới
                    </h2>

                    <form action="/admin/kpi-settings/create" method="POST" class="space-y-5">
                        <div>
                            <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Tên chương trình *</label>
                            <input type="text" name="title" required placeholder="VD: Thi đua bức phá tháng 3" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-teal-500 outline-none transition-all font-bold text-slate-800 text-sm">
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Từ ngày *</label>
                                <input type="datetime-local" name="start_date" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-teal-500 outline-none font-bold text-slate-800 text-sm">
                            </div>
                            <div>
                                <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Đến ngày *</label>
                                <input type="datetime-local" name="end_date" required class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-teal-500 outline-none font-bold text-slate-800 text-sm">
                            </div>
                        </div>

                        <div class="p-4 bg-indigo-50 border border-indigo-100 rounded-2xl flex items-center justify-between">
                            <div>
                                <p class="font-black text-indigo-900 text-sm">Bật Cộng dồn điểm (Stackable)</p>
                                <p class="text-[10px] font-bold text-indigo-500 mt-1">Cho phép tính điểm song song cùng lúc nhiều chiến dịch.</p>
                            </div>
                            <div class="relative inline-block w-12 mr-2 align-middle select-none transition duration-200 ease-in">
                                <input type="checkbox" name="is_stackable" value="1" id="toggle" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer z-10 transition-all right-6 border-slate-300"/>
                                <label for="toggle" class="toggle-label block overflow-hidden h-6 rounded-full bg-slate-300 cursor-pointer transition-colors"></label>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-slate-100">
                            <h3 class="text-sm font-black text-slate-800 mb-4"><i class="bi bi-star-fill text-amber-400"></i> Định nghĩa điểm số (Point/lần)</h3>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Dự Khóa học</label>
                                    <input type="number" name="point_study" value="0" min="0" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl font-black text-center text-slate-800">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Dự Cuộc họp</label>
                                    <input type="number" name="point_meeting" value="0" min="0" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl font-black text-center text-slate-800">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Mỗi Phiếu KS</label>
                                    <input type="number" name="point_survey" value="0" min="0" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl font-black text-center text-slate-800">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1 pl-2">Khách Dự Sự kiện</label>
                                    <input type="number" name="point_event_default" value="0" min="0" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl font-black text-center text-slate-800">
                                </div>
                                <div class="col-span-2">
                                    <label class="block text-[10px] font-black text-emerald-600 uppercase tracking-widest mb-1 pl-2">Khách hàng Active (Xác nhận thủ công)</label>
                                    <input type="number" name="point_active" value="0" min="0" class="w-full p-4 bg-emerald-50 border border-emerald-200 rounded-xl font-black text-center text-emerald-700 text-lg">
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="w-full py-4 bg-teal-600 text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] hover:bg-teal-700 transition-all shadow-lg shadow-teal-200 active:scale-95 flex justify-center items-center gap-2">
                            <i class="bi bi-floppy-fill"></i> LƯU CHIẾN DỊCH MỚI
                        </button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-7 space-y-6">
                <div class="flex items-center justify-between mb-4 px-2">
                    <h3 class="font-black text-xl text-slate-800">Danh sách chiến dịch</h3>
                    <span class="px-3 py-1 bg-slate-200 text-slate-600 rounded-full text-xs font-black"><%= programs.length %> Chương trình</span>
                </div>

                <div class="space-y-4">
                    <% if (programs.length === 0) { %>
                        <div class="card-custom bg-white p-12 text-center text-slate-400">
                            <i class="bi bi-inboxes text-5xl mb-3 block"></i>
                            <p class="font-bold">Chưa có chiến dịch KPI nào được tạo.</p>
                        </div>
                    <% } else { %>
                        <% programs.forEach(program => { 
                            let isActive = new Date() >= new Date(program.start_date) && new Date() <= new Date(program.end_date);
                        %>
                            <div class="card-custom bg-white p-6 relative overflow-hidden group hover:border-teal-300 transition-colors">
                                <% if (isActive) { %>
                                    <div class="absolute top-4 right-4 flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-600 rounded-lg text-[9px] font-black uppercase tracking-widest border border-emerald-100">
                                        <i class="bi bi-circle-fill text-[6px] animate-pulse"></i> Đang chạy
                                    </div>
                                <% } else { %>
                                    <div class="absolute top-4 right-4 flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-500 rounded-lg text-[9px] font-black uppercase tracking-widest border border-slate-200">
                                        Đã kết thúc / Chờ
                                    </div>
                                <% } %>

                                <div class="pr-32 mb-4">
                                    <h4 class="text-lg font-black text-slate-900 mb-1"><%= program.title %></h4>
                                    <p class="text-xs font-bold text-slate-500">
                                        <i class="bi bi-calendar-range"></i> <%= new Date(program.start_date).toLocaleDateString('vi-VN') %> ➔ <%= new Date(program.end_date).toLocaleDateString('vi-VN') %>
                                    </p>
                                </div>

                                <div class="grid grid-cols-5 gap-2 bg-slate-50 rounded-xl p-3 border border-slate-100 mb-4 text-center">
                                    <div><p class="text-[9px] text-slate-400 font-black uppercase">Khóa học</p><p class="font-black text-slate-800"><%= program.point_study %></p></div>
                                    <div><p class="text-[9px] text-slate-400 font-black uppercase">Cuộc họp</p><p class="font-black text-slate-800"><%= program.point_meeting %></p></div>
                                    <div><p class="text-[9px] text-slate-400 font-black uppercase">Khảo sát</p><p class="font-black text-slate-800"><%= program.point_survey %></p></div>
                                    <div><p class="text-[9px] text-amber-500 font-black uppercase">Sự kiện</p><p class="font-black text-amber-600"><%= program.point_event_default %></p></div>
                                    <div><p class="text-[9px] text-emerald-500 font-black uppercase">Active</p><p class="font-black text-emerald-600"><%= program.point_active %></p></div>
                                </div>

                                <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-2">
                                    <span class="text-[10px] font-black <%= program.is_stackable ? 'text-indigo-600' : 'text-slate-400' %> uppercase tracking-widest bg-white">
                                        <i class="bi <%= program.is_stackable ? 'bi-layers-fill' : 'bi-dash-circle' %>"></i> 
                                        <%= program.is_stackable ? 'Có cộng dồn (Stackable)' : 'Không cộng dồn (Off)' %>
                                    </span>
                                    
                                    <div class="flex gap-2">
                                        <button onclick="recalculatePoints(<%= program.id %>)" class="px-3 py-1.5 bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-600 rounded-lg text-[10px] uppercase tracking-widest font-black transition-colors flex items-center gap-1 shadow-sm">
                                            <i class="bi bi-arrow-repeat"></i> Đồng bộ
                                        </button>
                                        <button class="px-3 py-1.5 bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 rounded-lg text-xs font-black transition-colors">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <button class="px-3 py-1.5 bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 rounded-lg text-xs font-black transition-colors">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
    async function recalculatePoints(programId) {
        if(!confirm('Hệ thống sẽ quét lại toàn bộ lịch sử Khách hàng/Sự kiện để tính lại điểm cho chiến dịch này. Bạn có chắc chắn?')) return;
        
        try {
            const res = await fetch(`/admin/kpi-settings/${programId}/recalculate`, { method: 'POST' });
            const data = await res.json();
            
            if(data.success) {
                alert('✅ Cập nhật bảng xếp hạng thành công!');
                location.reload();
            } else {
                alert('❌ Lỗi: ' + data.message);
            }
        } catch (err) {
            alert('Lỗi kết nối máy chủ!');
        }
    }
    </script>
</body>
</html>