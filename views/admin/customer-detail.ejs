    <div class="max-w-6xl mx-auto px-4 mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100">
                <div
                    class="w-20 h-20 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-3xl mb-4 font-black">
                    <%= customer.full_name.charAt(0) %>
                </div>
                <h2 class="text-xl font-black mb-1">
                    <%= customer.full_name %>
                </h2>
                <div class="flex flex-col gap-2 mb-6">
                    <span
                        class="inline-flex w-fit items-center gap-1 px-3 py-1 bg-emerald-50 text-emerald-600 rounded-lg text-[10px] font-black uppercase tracking-widest">
                        <i class="bi bi-check-circle-fill"></i>
                        <%= customer.status || 'Đang chăm sóc' %>
                    </span>
                    <!-- <span
                        class="inline-flex w-fit items-center gap-1 px-3 py-1 bg-blue-50 text-blue-600 rounded-lg text-[10px] font-black uppercase tracking-widest">
                        <i class="bi bi-person-badge-fill"></i> Khách hàng của: <%= customer.staff_name
                            || 'Chưa phân bổ' %>
                    </span> -->
                </div>

                <div class="space-y-4 pt-4 border-t border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-slate-50 text-slate-500 rounded-xl flex items-center justify-center"><i
                                class="bi bi-telephone-fill"></i></div>
                        <div>
                            <p class="text-[10px] font-bold text-slate-400 uppercase">Điện thoại</p>
                            <p class="text-sm font-bold">
                                <%= customer.phone_1 %>
                            </p>
                        </div>
                    </div>
                    <!-- Thêm các thông tin khác của khách hàng tại đây nếu cần -->
                </div>
            </div>

            <div
                class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-200 mt-6 border-t-4 border-t-blue-500">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-tight mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    Nhân Viên Phụ Trách
                </h3>

                <% if (customer.staff_name) { %>
                    <div
                        class="flex items-center gap-4 p-4 bg-slate-50 rounded-2xl border border-slate-100 hover:border-blue-200 transition-colors group">

                        <img src="<%= customer.staff_avatar || '/img/default-avatar.png' %>" alt="Avatar"
                            class="w-14 h-14 rounded-full object-cover shadow-md group-hover:scale-105 transition-transform border-2 border-white ring-1 ring-slate-200">

                        <div>
                            <h4 class="text-base font-black text-slate-800 m-0 leading-tight">
                                <%= customer.staff_name %>
                            </h4>
                            <div class="flex items-center gap-2 mt-1.5">
                                <span
                                    class="px-2 py-1 bg-blue-100 text-blue-700 text-[9px] font-black uppercase tracking-widest rounded-md">
                                    <i class="bi bi-telephone-fill"></i> SĐT
                                </span>
                                <a href="tel:<%= customer.staff_phone %>"
                                    class="text-sm font-bold text-slate-600 hover:text-blue-600 transition-colors">
                                    <%= customer.staff_phone || 'Chưa cập nhật' %>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% } else { %>
                        <div
                            class="flex flex-col items-center justify-center p-6 bg-slate-50 rounded-2xl border border-dashed border-slate-300 text-center">
                            <i class="bi bi-person-slash text-3xl text-slate-300 mb-2"></i>
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Khách tự do
                                <br>(Chưa phân công)</span>
                        </div>
                        <% } %>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="bg-white rounded-[2rem] p-6 sm:p-8 shadow-sm border border-slate-100 min-h-[500px]">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="font-black flex items-center gap-2"><i class="bi bi-activity text-indigo-500"></i> Lịch
                        sử Tương tác</h3>
                    <span class="text-xs font-bold text-slate-400 bg-slate-50 px-3 py-1 rounded-full">
                        <%= notes.length %> bản ghi
                    </span>
                </div>

                <div class="relative border-l-2 border-indigo-100 ml-4 space-y-8 pb-4">
                    <% if (notes.length===0) { %>
                        <p class="text-slate-400 text-sm ml-6 italic">Nhân viên chưa có hoạt động tương tác nào với
                            khách hàng này.</p>
                        <% } else { %>
                            <% notes.forEach(note=> { %>
                                <div class="relative pl-8 group">
                                    <% let iconBg='bg-slate-100 text-slate-500' ; let iconClass='bi-pin-angle-fill' ;
                                        if(note.note_type==='call' ) { iconBg='bg-blue-500 text-white' ;
                                        iconClass='bi-telephone-fill' ; } else if(note.note_type==='meeting' ) {
                                        iconBg='bg-amber-500 text-white' ; iconClass='bi-cup-hot-fill' ; } else
                                        if(note.note_type==='message' ) { iconBg='bg-emerald-500 text-white' ;
                                        iconClass='bi-chat-dots-fill' ; } %>
                                        <div
                                            class="absolute -left-[17px] top-0 w-8 h-8 <%= iconBg %> rounded-full flex items-center justify-center text-sm shadow-md ring-4 ring-white group-hover:scale-110 transition-transform">
                                            <i class="bi <%= iconClass %>"></i>
                                        </div>

                                        <div
                                            class="bg-slate-50 rounded-2xl p-4 border border-slate-100 hover:border-indigo-200 hover:shadow-md transition-all">
                                            <div
                                                class="flex justify-between items-start mb-2 border-b border-slate-200/50 pb-2">
                                                <div class="flex items-center gap-2">
                                                    <div
                                                        class="w-5 h-5 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center text-[10px] font-black">
                                                        <%= note.author_name ? note.author_name.charAt(0) : '?' %>
                                                    </div>
                                                    <span class="text-xs font-bold text-slate-700">
                                                        <%= note.author_name || 'Ẩn danh' %>
                                                    </span>
                                                </div>
                                                <span
                                                    class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                                    <%= new Date(note.created_at).toLocaleString('vi-VN') %>
                                                </span>
                                            </div>
                                            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line mt-2">
                                                <%= note.content %>
                                            </p>

                                            <% if (note.reminder_time) { %>
                                                <div
                                                    class="mt-3 inline-flex items-center gap-1.5 px-3 py-1 bg-rose-50 text-rose-600 rounded-lg text-[10px] font-black uppercase tracking-widest border border-rose-100">
                                                    <i class="bi bi-alarm-fill"></i> Báo thức CRM: <%= new
                                                        Date(note.reminder_time).toLocaleString('vi-VN') %>
                                                </div>
                                                <% } %>
                                        </div>
                                </div>
                                <% }) %>
                                    <% } %>
                </div>
            </div>
        </div>

    </div>
    <dialog id="editModal"
        class="rounded-[2.5rem] shadow-2xl p-0 w-full max-w-3xl backdrop:backdrop-blur-sm border-none overflow-hidden">
        <div class="bg-white flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50 shrink-0">
                <div>
                    <h3 class="font-black text-slate-800 uppercase tracking-tight m-0">Cập nhật hồ sơ chi tiết</h3>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest m-0">ID Khách hàng: #<%=
                            customer.id %>
                    </p>
                </div>
                <button onclick="closeEditModal()"
                    class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-200 text-slate-500 hover:bg-rose-500 hover:text-white transition-all shadow-sm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="fullAjaxEditForm" class="overflow-y-auto p-6 md:p-8 space-y-8">
                <div class="p-5 bg-indigo-50/50 border border-indigo-100 rounded-[1.5rem]">
                    <h4
                        class="text-[11px] font-black text-indigo-600 uppercase tracking-widest mb-3 ml-1 flex items-center gap-2">
                        <i class="bi bi-person-gear"></i> Nhân viên phụ trách
                    </h4>
                    <div class="relative">
                        <select name="staff_id"
                            class="w-full p-4 bg-white border border-indigo-200 text-slate-900 rounded-2xl font-bold outline-none focus:ring-4 focus:ring-indigo-500/10 appearance-none cursor-pointer">
                            <option value="">-- Khách tự do (Chưa giao cho ai) --</option>
                            <% staffs.forEach(staff=> { %>
                                <option value="<%= staff.id %>" <%=customer.staff_id===staff.id ? 'selected' : '' %>><%=
                                        staff.full_name %>
                                </option>
                                <% }) %>
                        </select>
                        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-indigo-400"><i
                                class="bi bi-chevron-down"></i></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Họ
                            và tên *</label>
                        <input type="text" name="full_name" value="<%= customer.full_name %>" required
                            class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold uppercase focus:bg-white focus:border-indigo-500 outline-none transition-all">
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Số
                            điện thoại 1 *</label>
                        <input type="text" name="phone_1" value="<%= customer.phone_1 %>" required
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Số
                            điện thoại 2</label>
                        <input type="text" name="phone_2" value="<%= customer.phone_2 %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Giới
                            tính</label>
                        <div class="relative">
                            <select name="gender"
                                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold appearance-none cursor-pointer focus:bg-white">
                                <option value="Nam" <%=customer.gender==='Nam' ? 'selected' : '' %>>Nam</option>
                                <option value="Nữ" <%=customer.gender==='Nữ' ? 'selected' : '' %>>Nữ</option>
                                <option value="Chưa xác định" <%=customer.gender==='Chưa xác định' ? 'selected' : '' %>
                                    >Chưa xác định</option>
                            </select>
                            <div
                                class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-chevron-down"></i></div>
                        </div>
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Ngày
                            sinh</label>
                        <input type="date" name="birthday"
                            value="<%= customer.birthday ? new Date(customer.birthday.getTime() - (customer.birthday.getTimezoneOffset() * 60000)).toISOString().split('T')[0] : '' %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Email</label>
                        <input type="email" name="email" value="<%= customer.email %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div>
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Số
                            CCCD</label>
                        <input type="text" name="cccd" value="<%= customer.cccd %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div class="md:col-span-2">
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Địa
                            chỉ thường trú</label>
                        <input type="text\" name="address_1" value="<%= customer.address_1 %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>

                    <div class="md:col-span-2">
                        <label
                            class="block text-[11px] font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Địa
                            chỉ tạm trú / Khác</label>
                        <input type="text\" name="address_2" value="<%= customer.address_2 %>"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:bg-white">
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-slate-100 shrink-0">
                    <button type="submit"
                        class="flex-[2] py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-sm uppercase tracking-widest transition-all shadow-lg shadow-indigo-200 active:scale-95 flex justify-center items-center gap-2">
                        <i class="bi bi-check-lg text-lg"></i> Cập Nhật Hồ Sơ
                    </button>
                    <button type="button" onclick="closeEditModal()"
                        class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-black text-sm uppercase tracking-widest transition-all flex justify-center items-center gap-2">
                        Hủy Bỏ
                    </button>
                </div>
            </form>
        </div>
    </dialog>

    <script>
        const modal = document.getElementById('editModal');
        const form = document.getElementById('fullAjaxEditForm');

        function openEditModal() { modal.showModal(); }
        function closeEditModal() { modal.close(); }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                // Gọi API sửa khách hàng (trả về JSON)
                const response = await fetch('/admin/customers/edit/<%= customer.id %>', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (result.success) {
                    alert('✅ Hồ sơ đã được cập nhật!');
                    window.location.reload(); // Load lại trang tại chỗ để cập nhật UI hiển thị
                } else {
                    alert('❌ Lỗi: ' + result.message);
                }
            } catch (err) {
                console.error(err);
                alert('🛑 Lỗi hệ thống, không thể lưu dữ liệu!');
            }
        });
    </script>
</body>

</html>