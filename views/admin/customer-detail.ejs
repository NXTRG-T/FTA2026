<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giám sát Hồ sơ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(15px);
        }
    </style>
</head>

<body class="text-slate-800 pb-20">

    <div class="sticky top-0 z-50 glass-panel shadow-sm border-b border-white">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        
        
        <div class="flex items-center gap-5">
            <a href="/admin/reports" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Trở về
            </a>
            <div>
                <h1 class="font-black text-xl m-0 text-slate-800 flex items-center gap-2">
                    <%= customer.full_name %> ✨
                </h1>
                <p class="text-[10px] font-bold text-indigo-500 uppercase tracking-widest m-0">
                    <i class="bi bi-shield-check"></i> Giám sát Khách hàng
                </p>
            </div>
        </div>

        <button onclick="openEditModal()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-black text-sm uppercase tracking-widest shadow-md transition-transform hover:scale-105 flex items-center gap-2">
            <i class="bi bi-pencil-square"></i> Sửa hồ sơ
        </button>
        
    </div>
</div>
