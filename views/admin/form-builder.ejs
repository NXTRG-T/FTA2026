<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= form ? 'Sửa' : 'Tạo' %> Biểu Mẫu Khảo Sát</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800 pb-20">

<div class="max-w-4xl mx-auto p-4 md:p-6 md:pt-8">
    
    <div class="mb-4">
        <a href="/admin/forms" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
            <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Trở về Quản lý BM
        </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-white p-5 md:p-6 rounded-[2rem] shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                <i class="bi bi-tools text-indigo-500"></i> <%= form ? 'Chỉnh Sửa Biểu Mẫu' : 'Xây Dựng Biểu Mẫu Mới' %>
            </h2>
        </div>
    </div>

    <form action="/admin/forms/save" method="POST" id="surveyBuilderForm">
        <input type="hidden" name="id" value="<%= form ? form.id : '' %>">
        <input type="hidden" name="form_structure" id="form_structure">

        <div class="bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-200 mb-8 border-t-4 border-t-indigo-500">
            <div class="mb-6">
                <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Tên biểu mẫu *</label>
                <input type="text" name="title" value="<%= form ? form.title : '' %>" required placeholder="VD: Khảo sát mức độ hài lòng khách hàng..." class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 outline-none transition-all font-bold text-slate-800 text-lg">
            </div>
            <div>
                <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Mô tả mục đích (Tùy chọn)</label>
                <textarea name="description" rows="2" placeholder="Ghi chú thêm về biểu mẫu này..." class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 outline-none transition-all font-medium text-slate-700"><%= form ? form.description : '' %></textarea>
            </div>
        </div>

        <h4 class="font-black text-slate-800 text-lg mb-4 flex items-center gap-2"><i class="bi bi-list-task"></i> DANH SÁCH CÂU HỎI</h4>
        <div id="questions-container" class="space-y-6 mb-6">
            </div>

        <button type="button" onclick="addQuestion()" class="w-full py-5 border-2 border-dashed border-indigo-300 text-indigo-600 bg-indigo-50/50 hover:bg-indigo-100 font-black rounded-[2rem] transition-all flex items-center justify-center gap-2 mb-8 text-sm uppercase tracking-widest hover:-translate-y-1">
            <i class="bi bi-plus-circle-fill text-lg"></i> THÊM CÂU HỎI MỚI
        </button>

        <div class="border-t border-slate-200 pt-6 sticky bottom-4">
            <button type="submit" class="w-full py-5 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-black rounded-[2rem] shadow-xl shadow-indigo-200 text-sm uppercase tracking-widest transition-all flex items-center justify-center gap-2 hover:-translate-y-1">
                <i class="bi bi-floppy-fill text-lg"></i> LƯU BIỂU MẪU
            </button>
        </div>
    </form>
</div>

<script>
    // Dữ liệu khởi tạo (Nếu là Edit)
    let questions = <%- form && form.form_structure ? form.form_structure : '[]' %>;
    const container = document.getElementById('questions-container');

    function renderQuestions() {
        container.innerHTML = '';
        questions.forEach((q, qIndex) => {
            let optionsHtml = '';
            q.options.forEach((opt, oIndex) => {
                optionsHtml += `
                    <div class="flex items-center gap-3 mb-3 group">
                        <i class="bi bi-circle text-slate-300 text-lg"></i>
                        <input type="text" value="${opt}" oninput="updateOption(${qIndex}, ${oIndex}, this.value)" class="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-800 outline-none focus:bg-white focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all" placeholder="Nhập đáp án...">
                        <button type="button" onclick="removeOption(${qIndex}, ${oIndex})" class="w-10 h-10 flex items-center justify-center bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white rounded-xl transition-all shadow-sm opacity-0 group-hover:opacity-100" title="Xóa đáp án"><i class="bi bi-trash-fill"></i></button>
                    </div>
                `;
            });

            container.innerHTML += `
                <div class="bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm relative group/card">
                    <button type="button" onclick="removeQuestion(${qIndex})" class="absolute top-6 right-6 px-3 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-lg font-black text-[10px] uppercase tracking-widest transition-all opacity-0 group-hover/card:opacity-100 flex items-center gap-1 shadow-sm"><i class="bi bi-x-lg"></i> Xóa câu này</button>
                    
                    <div class="mb-6 pr-24">
                        <label class="block text-xs font-black text-indigo-500 uppercase tracking-widest mb-2 ml-1">Câu hỏi ${qIndex + 1}</label>
                        <input type="text" value="${q.question}" oninput="updateQuestion(${qIndex}, 'question', this.value)" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 outline-none transition-all font-bold text-slate-900" placeholder="Nhập nội dung câu hỏi...">
                    </div>
                    
                    <div class="mb-6 pl-2 border-l-2 border-indigo-100">
                        <label class="block text-[10px] font-black text-slate-400 mb-3 uppercase tracking-widest ml-1">Các đáp án</label>
                        ${optionsHtml}
                        <button type="button" onclick="addOption(${qIndex})" class="mt-2 inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-xl font-black text-[10px] uppercase tracking-widest transition-all"><i class="bi bi-plus-lg"></i> Thêm đáp án</button>
                    </div>
                    
                    <div class="border-t border-slate-100 pt-5 flex items-center gap-3">
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">
                            Khách hàng được chọn TỐI ĐA: 
                        </label>
                        <input type="number" min="1" max="10" value="${q.max_choices}" oninput="updateQuestion(${qIndex}, 'max_choices', this.value)" class="w-16 px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-center font-bold text-indigo-600 outline-none focus:ring-1 focus:ring-indigo-400">
                        <span class="text-xs font-black text-slate-500 uppercase tracking-widest">Đáp án</span>
                    </div>
                </div>
            `;
        });
    }

    function addQuestion() { questions.push({ question: '', max_choices: 1, options: ['Đáp án 1', 'Đáp án 2'] }); renderQuestions(); }
    function removeQuestion(index) { questions.splice(index, 1); renderQuestions(); }
    function updateQuestion(index, key, value) { questions[index][key] = value; }
    function addOption(qIndex) { questions[qIndex].options.push(''); renderQuestions(); }
    function updateOption(qIndex, oIndex, value) { questions[qIndex].options[oIndex] = value; }
    function removeOption(qIndex, oIndex) { questions[qIndex].options.splice(oIndex, 1); renderQuestions(); }

    // Validate trước khi submit
    document.getElementById('surveyBuilderForm').addEventListener('submit', function(e) {
        document.getElementById('form_structure').value = JSON.stringify(questions);
        if(questions.length === 0) {
            e.preventDefault(); 
            alert("Vui lòng thêm ít nhất 1 câu hỏi trước khi lưu!");
        }
    });

    // Khởi tạo ban đầu
    if(questions.length === 0) addQuestion(); else renderQuestions();
</script>
</body>
</html>