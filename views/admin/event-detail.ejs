<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi Tiết Sự Kiện - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="text-slate-800 pb-20">
    <div class="max-w-[1200px] mx-auto p-4 md:p-6 md:pt-8">
        <!-- Nút quay lại -->
        <div class="mb-4">
            <a href="/admin/events" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-blue-400 text-slate-600 hover:text-blue-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group active:scale-95">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Trở lại Sự kiện
            </a>
        </div>

        <!-- Thông tin Sự kiện -->
        <div class="bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-200 mb-6 border-t-4 border-t-blue-500">
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 mb-5"><%= event.event_name %></h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm text-slate-700">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1"><i class="bi bi-geo-alt-fill text-red-500 mr-1"></i> Địa điểm</p>
                    <p class="font-bold"><%= event.location %></p>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1"><i class="bi bi-clock-fill text-orange-500 mr-1"></i> Bắt đầu</p>
                    <p class="font-bold"><%= formatDateTime(event.start_time) %></p>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1"><i class="bi bi-clock-history text-cyan-500 mr-1"></i> Kết thúc</p>
                    <p class="font-bold"><%= formatDateTime(event.end_time) %></p>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1"><i class="bi bi-star-fill text-amber-500 mr-1"></i> Điểm KPI</p>
                    <p class="font-bold"><%= event.kpi_points > 0 ? event.kpi_points : 'Dùng mặc định' %></p>
                </div>
            </div>
        </div>

        <!-- Bảng danh sách Khách mời -->
        <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <h3 class="text-lg font-black text-slate-800 uppercase tracking-tight flex items-center gap-2">
                    <i class="bi bi-people-fill text-blue-500 text-xl"></i> Danh sách khách mời
                </h3>
                <span class="px-4 py-2 bg-blue-50 text-blue-600 rounded-xl text-xs font-black uppercase tracking-widest border border-blue-100 shadow-sm">
                    Tổng cộng: <%= participants.length %> Khách
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-200 bg-slate-50">
                            <th class="p-4 rounded-tl-xl">Khách hàng</th>
                            <th class="p-4">Số điện thoại</th>
                            <th class="p-4">Trạng thái</th>
                            <th class="p-4">Nhân viên phụ trách</th>
                            <th class="p-4 rounded-tr-xl">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-medium text-slate-700 divide-y divide-slate-100">
                        <% if(participants.length === 0) { %>
                            <tr>
                                <td colspan="5" class="p-10 text-center text-slate-400 italic font-bold">Chưa có khách hàng nào được thêm vào danh sách mời.</td>
                            </tr>
                        <% } else { %>
                            <% participants.forEach(p => { 
                                let statusColor = 'bg-slate-100 text-slate-600';
                                if(p.status === 'Đã tham dự') statusColor = 'bg-emerald-100 text-emerald-700 border border-emerald-200';
                                else if(p.status === 'Không tham dự' || p.status === 'Từ chối tham gia') statusColor = 'bg-red-100 text-red-700 border border-red-200';
                                else if(p.status === 'Đã nhận lời mời') statusColor = 'bg-blue-100 text-blue-700 border border-blue-200';
                                else if(p.status === 'Cần suy nghĩ thêm') statusColor = 'bg-amber-100 text-amber-700 border border-amber-200';
                            %>
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="p-4 font-black text-slate-900"><%= p.full_name %></td>
                                <td class="p-4 font-bold text-slate-600"><%= p.phone_1 %></td>
                                <td class="p-4">
                                    <span class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest shadow-sm <%= statusColor %>">
                                        <%= p.status || 'Đã mời' %>
                                    </span>
                                </td>
                                <td class="p-4 font-bold"><%= p.staff_name || 'Hệ thống' %></td>
                                <td class="p-4 truncate max-w-[250px]" title="<%= p.notes %>"><%= p.notes || '--' %></td>
                            </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>