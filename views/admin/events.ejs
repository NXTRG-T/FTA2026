<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sự Kiện - FTA CRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-gray-800 pb-20">

<div class="max-w-[1400px] mx-auto p-4 md:p-6 md:pt-8">
    
    <div class="mb-4">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-orange-400 text-slate-600 hover:text-orange-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
            <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Dashboard
        </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-white p-5 md:p-6 rounded-[2rem] shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                <i class="bi bi-calendar-event-fill text-orange-500"></i> Quản Lý Sự Kiện
            </h2>
            <p class="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1 m-0">Lên lịch & Theo dõi hội thảo</p>
        </div>
        <div class="shrink-0">
            <button class="px-6 py-3 bg-orange-500 text-white hover:bg-orange-600 rounded-xl font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 shadow-lg shadow-orange-200 hover:-translate-y-1" onclick="toggleEdit('add-event-form')">
                <i class="bi bi-plus-circle-fill text-base"></i> Tạo Sự Kiện
            </button>
        </div>
    </div>

    <div class="hidden bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8 transition-all" id="add-event-form">
        <h4 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 mt-0">Thêm Sự Kiện Mới</h4>
        <form action="/admin/events/add" method="POST">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Tên sự kiện *</label>
                <input type="text" name="event_name" required class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Địa điểm tổ chức *</label>
                <input type="text" name="location" required class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Thời gian bắt đầu *</label>
                    <input type="datetime-local" name="start_time" required class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Thời gian kết thúc *</label>
                    <input type="datetime-local" name="end_time" required class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
                </div>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Mô tả sự kiện (Không bắt buộc)</label>
                <textarea name="description" rows="3" placeholder="Nhập nội dung mô tả chi tiết..." class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors"></textarea>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Link đính kèm (Google Drive, Tài liệu...)</label>
                <input type="url" name="drive_link" placeholder="https://drive.google.com/..." class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Nhân viên phụ trách *</label>
                <div class="relative mb-2">
                    <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" placeholder="Tìm theo tên hoặc số điện thoại..." onkeyup="filterStaff(this, 'add-staff-list')" class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none transition-colors">
                </div>
                <div id="add-staff-list" class="bg-slate-50 border border-gray-200 rounded-lg p-3 max-h-48 overflow-y-auto">
                    <% staffList.forEach(staff => { %>
                        <label class="flex items-center gap-3 px-2 py-1.5 hover:bg-slate-200 rounded cursor-pointer transition-colors text-sm font-medium text-slate-700">
                            <input type="checkbox" name="manager_ids" value="<%= staff.id %>" class="w-4 h-4 text-orange-600 rounded border-gray-300 focus:ring-orange-500"> 
                            <span><i class="bi bi-person text-gray-400"></i> <%= staff.full_name %> - <%= staff.phone_1 || 'N/A' %></span>
                        </label>
                    <% }) %>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="flex-1 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-bold transition-colors flex justify-center items-center gap-2"><i class="bi bi-plus-circle"></i> TẠO SỰ KIỆN</button>
                <button type="button" class="flex-1 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-bold transition-colors flex justify-center items-center gap-2" onclick="toggleEdit('add-event-form')"><i class="bi bi-x-circle-fill"></i> HỦY BỎ</button>
            </div>
        </form>
    </div>

    <h4 class="text-lg font-bold text-gray-800 mb-4">DANH SÁCH SỰ KIỆN (<%= events.length %>)</h4>
    
    <div class="relative mb-6">
        <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
        <input type="text" id="search-event" placeholder="Tìm tên sự kiện, địa điểm..." onkeyup="searchItems('search-event', '.event-card')" class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-orange-200 focus:border-orange-500 outline-none bg-white shadow-sm transition-colors">
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    <% events.forEach(ev => { 
        const isStarted = new Date(ev.start_time) <= new Date();
    %>
        <div class="event-card bg-white p-5 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-orange-500 hover:shadow-md transition-all flex flex-col">
            <h4 class="text-lg font-bold text-gray-800 mb-3 mt-0"><%= ev.event_name %></h4>
            
            <p class="text-sm text-gray-600 mb-1.5 flex items-start gap-2"><i class="bi bi-geo-alt-fill text-red-500 mt-0.5"></i> <span class="flex-1"><b>Địa điểm:</b> <%= ev.location %></span></p>
            <p class="text-sm text-gray-600 mb-1.5 flex items-start gap-2"><i class="bi bi-clock-fill text-orange-500 mt-0.5"></i> <span><b>Bắt đầu:</b> <%= formatDateTime(ev.start_time) %></span></p>
            <p class="text-sm text-gray-600 mb-3 flex items-start gap-2"><i class="bi bi-clock-history text-cyan-500 mt-0.5"></i> <span><b>Kết thúc:</b> <%= formatDateTime(ev.end_time) %></span></p>
            
            <% if(ev.description) { %>
                <div class="bg-slate-50 p-3 rounded-lg text-sm text-gray-600 mb-3 border border-gray-100 break-words">
                    <b class="block mb-1 text-gray-700">Mô tả:</b>
                    <%= ev.description %>
                </div>
            <% } %>

            <% if(ev.drive_link) { %>
                <p class="text-sm mb-3"><b class="text-gray-700">Tài liệu:</b> <a href="<%= ev.drive_link %>" target="_blank" class="text-blue-600 hover:text-blue-800 font-semibold underline decoration-blue-200 underline-offset-2">Xem liên kết đính kèm</a></p>
            <% } %>

            <div class="mb-4">
                <b class="text-sm text-gray-700 block mb-1.5">Phụ trách:</b>
                <div class="flex flex-col gap-1.5">
                    <% ev.managers.forEach(m => { %>
                        <div class="flex items-center gap-2 px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-sm w-fit">
                            <span class="font-bold text-slate-800"><i class="bi bi-person-badge-fill text-indigo-500 mr-1"></i> <%= m.full_name %></span>
                            <span class="text-slate-300">|</span>
                            <a href="tel:<%= m.phone_1 %>" class="font-semibold text-emerald-600 hover:text-emerald-700 transition-colors"><i class="bi bi-telephone-fill"></i> <%= m.phone_1 || 'N/A' %></a>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="mt-auto">
                <div class="flex flex-wrap items-center justify-end gap-2 pt-4 border-t border-dashed border-gray-200">
                    <a href="/admin/events/<%= ev.id %>/qr-display" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-full font-black text-[10px] uppercase tracking-widest transition-colors shadow-sm border border-indigo-100">
                        <i class="bi bi-qr-code-scan text-sm"></i> QR Check-in
                    </a>
                    <a href="/admin/events/stats/<%= ev.id %>" class="px-3 py-1.5 bg-cyan-100 text-cyan-700 hover:bg-cyan-200 rounded-md text-sm font-semibold flex items-center gap-1 transition-colors"><i class="bi bi-bar-chart-fill"></i> Báo cáo</a>
                    <% if(!isStarted) { %>
                        <button class="px-3 py-1.5 bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-md text-sm font-semibold flex items-center gap-1 transition-colors" onclick="toggleEdit('edit-event-<%= ev.id %>')"><i class="bi bi-pencil-square"></i> Sửa</button>
                    <% } else { %>
                        <span class="text-gray-400 text-xs font-medium italic px-2">Đã diễn ra</span>
                    <% } %>

                    <form action="/admin/events/delete/<%= ev.id %>" method="POST" onsubmit="return confirm('Xác nhận xóa sự kiện này?');" class="m-0">
                        <button type="submit" class="px-3 py-1.5 bg-red-100 text-red-700 hover:bg-red-200 rounded-md text-sm font-semibold flex items-center gap-1 transition-colors"><i class="bi bi-trash"></i> Xóa</button>
                    </form>
                </div>

                <% if(!isStarted) { %>
                    <div class="hidden mt-4 pt-4 border-t border-gray-200" id="edit-event-<%= ev.id %>">
                        <h5 class="mb-3 text-blue-600 font-bold mt-0 text-sm uppercase">Sửa thông tin sự kiện</h5>
                        <form action="/admin/events/edit/<%= ev.id %>" method="POST">
                            <div class="mb-3">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Tên sự kiện</label>
                                <input type="text" name="event_name" value="<%= ev.event_name %>" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm">
                            </div>
                            <div class="mb-3">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Địa điểm</label>
                                <input type="text" name="location" value="<%= ev.location %>" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm">
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1">Bắt đầu</label>
                                    <input type="datetime-local" name="start_time" value="<%= new Date(ev.start_time.getTime() - (ev.start_time.getTimezoneOffset() * 60000)).toISOString().slice(0,16) %>" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1">Kết thúc</label>
                                    <input type="datetime-local" name="end_time" value="<%= new Date(ev.end_time.getTime() - (ev.end_time.getTimezoneOffset() * 60000)).toISOString().slice(0,16) %>" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Mô tả</label>
                                <textarea name="description" rows="2" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm"><%= ev.description %></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Link tài liệu</label>
                                <input type="url" name="drive_link" value="<%= ev.drive_link %>" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-sm">
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-bold text-gray-600 mb-2">Nhân viên phụ trách</label>
                                <div class="relative mb-2">
                                    <i class="bi bi-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="text" placeholder="Tìm tên, SĐT..." onkeyup="filterStaff(this, 'edit-staff-list-<%= ev.id %>')" class="w-full pl-7 pr-2 py-1.5 border border-gray-300 rounded-md focus:ring-1 focus:ring-orange-300 outline-none text-xs">
                                </div>
                                <div id="edit-staff-list-<%= ev.id %>" class="bg-slate-50 border border-gray-200 rounded-md p-2 max-h-32 overflow-y-auto">
                                    <% staffList.forEach(staff => { 
                                        const isAssigned = ev.managers && ev.managers.some(m => m.id === staff.id);
                                    %>
                                        <label class="flex items-center gap-2 px-2 py-1 hover:bg-slate-200 rounded cursor-pointer text-xs font-medium text-slate-700">
                                            <input type="checkbox" name="manager_ids" value="<%= staff.id %>" <%= isAssigned ? 'checked' : '' %> class="w-3.5 h-3.5 text-orange-600 rounded border-gray-300"> 
                                            <span><%= staff.full_name %> - <%= staff.phone_1 || 'N/A' %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button type="submit" class="flex-1 bg-orange-600 hover:bg-orange-700 text-white py-2 rounded-md font-bold text-sm transition-colors"><i class="bi bi-check-circle-fill"></i> LƯU</button>
                                <button type="button" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 rounded-md font-bold text-sm transition-colors" onclick="toggleEdit('edit-event-<%= ev.id %>')"><i class="bi bi-x-circle-fill"></i> HỦY</button>
                            </div>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    <% }) %>
    </div>

    <script>
        function toggleEdit(id) {
            document.getElementById(id).classList.toggle('hidden');
        }

        function searchItems(inputId, itemClass) {
            const keyword = document.getElementById(inputId).value.toLowerCase();
            const items = document.querySelectorAll(itemClass);
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(keyword) ? 'flex' : 'none';
            });
        }

        function filterStaff(inputElement, listId) {
            const keyword = inputElement.value.toLowerCase();
            const listContainer = document.getElementById(listId);
            const labels = listContainer.querySelectorAll('label');
            labels.forEach(label => {
                const text = label.innerText.toLowerCase();
                label.style.display = text.includes(keyword) ? 'flex' : 'none';
            });
        }
    </script>
</div>
</body>
</html>