<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cài đặt Hệ thống</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800 pb-20">

<div class="max-w-4xl mx-auto p-4 md:p-6 md:pt-8">
    
    <div class="mb-4">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-400 text-slate-600 hover:text-indigo-600 rounded-full font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
            <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Dashboard
        </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-white p-5 md:p-6 rounded-[2.5rem] shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                <i class="bi bi-palette-fill text-indigo-500"></i> Nhận diện Thương hiệu
            </h2>
            <p class="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1 m-0">Tùy chỉnh Logo & Banner sự kiện trong tháng</p>
        </div>
    </div>

    <form action="/admin/settings/update-media" method="POST" enctype="multipart/form-data" class="space-y-6">
        
        <div class="bg-white p-6 md:p-8 rounded-[2.5rem] shadow-sm border border-slate-200 border-t-4 border-t-indigo-500">
            <h3 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2">
                <i class="bi bi-heptagon-half text-indigo-500"></i> Logo Hệ thống
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div class="p-6 bg-slate-50 rounded-[2rem] border-2 border-dashed border-slate-300 flex justify-center items-center min-h-[120px]">
                    <img id="logo-preview" src="<%= typeof system_logo !== 'undefined' ? system_logo : '/img/default-logo.png' %>" class="h-16 object-contain drop-shadow-sm transition-all">
                </div>
                <div>
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-3">Tải lên Logo mới (PNG/WebP)</label>
                    <input type="file" name="logo" accept="image/*" onchange="previewImage(this, 'logo-preview')" class="block w-full text-sm text-slate-500 file:mr-4 file:py-3 file:px-6 file:rounded-full file:border-0 file:text-xs file:font-black file:uppercase file:tracking-widest file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition-all cursor-pointer">
                    <p class="text-[10px] text-slate-400 font-bold mt-2"><i class="bi bi-info-circle"></i> Khuyên dùng ảnh nền trong suốt, chiều cao lý tưởng 100px.</p>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 md:p-8 rounded-[2.5rem] shadow-sm border border-slate-200 border-t-4 border-t-pink-500">
            <h3 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2">
                <i class="bi bi-image text-pink-500"></i> Banner Dashboard Nhân viên
            </h3>
            
            <div class="w-full h-48 md:h-64 bg-slate-100 rounded-[2rem] border border-slate-200 overflow-hidden mb-6 shadow-inner">
                <img id="banner-preview" src="<%= typeof dashboard_banner !== 'undefined' ? dashboard_banner : '/img/default-banner.webp' %>" class="w-full h-full object-cover transition-all">
            </div>
            
            <div>
                <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-3">Tải lên Poster/Banner sự kiện tháng</label>
                <input type="file" name="banner" accept="image/*" onchange="previewImage(this, 'banner-preview')" class="block w-full text-sm text-slate-500 file:mr-4 file:py-3 file:px-6 file:rounded-full file:border-0 file:text-xs file:font-black file:uppercase file:tracking-widest file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100 transition-all cursor-pointer">
                <p class="text-[10px] text-slate-400 font-bold mt-2"><i class="bi bi-info-circle"></i> Ảnh sẽ tự động được nén và cắt về chiều ngang 1200px để tối ưu tốc độ tải.</p>
            </div>
        </div>

        <div class="sticky bottom-6 z-10">
            <button type="submit" class="w-full py-5 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-black rounded-full shadow-xl shadow-indigo-200 text-sm uppercase tracking-widest transition-transform hover:-translate-y-1 flex items-center justify-center gap-2">
                <i class="bi bi-cloud-arrow-up-fill text-lg"></i> Cập nhật Nhận diện Thương hiệu
            </button>
        </div>

    </form>
</div>

<script>
    // Đọc file ảnh trên máy và hiển thị xem trước ngay lập tức
    function previewImage(input, previewId) {
        const preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const maxSizeMB = 5; // Giới hạn 5MB cho Admin
            if (file.size > maxSizeMB * 1024 * 1024) {
                alert(`🛑 LỖI: Ảnh nặng ${(file.size / (1024*1024)).toFixed(2)}MB. Vui lòng chọn ảnh nhỏ hơn ${maxSizeMB}MB!`);
                input.value = ''; 
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
</body>
</html>