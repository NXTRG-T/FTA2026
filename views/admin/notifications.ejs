<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Thông Báo - FTA CRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        #loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.7); z-index: 9999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(2px); }
        .spinner { border: 5px solid #f3f3f3; border-top: 5px solid #6f42c1; border-radius: 50%; width: 45px; height: 45px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 font-sans text-gray-800 pb-20">

    <div id="loading-overlay"><div class="spinner"></div></div>

<div class="max-w-[1400px] mx-auto p-4 md:p-6 md:pt-8">
    
    <div class="mb-4">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-purple-400 text-slate-600 hover:text-purple-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
            <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Dashboard
        </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-white p-5 md:p-6 rounded-[2rem] shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                <i class="bi bi-bell-fill text-purple-600"></i> Quản Lý Thông Báo
            </h2>
            <p class="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1 m-0">Truyền đạt tin tức nội bộ</p>
        </div>
        <div class="shrink-0">
            <button type="button" id="btnToggleAdd" class="px-6 py-3 bg-purple-600 text-white hover:bg-purple-700 rounded-xl font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 shadow-lg shadow-purple-200 hover:-translate-y-1" onclick="toggleAddForm()">
                <i class="bi bi-send-fill text-base"></i> Tạo Thông Báo
            </button>
        </div>
    </div>

    <div class="hidden bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8 transition-all" id="add-noti-form">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100 mt-0">
            <h4 class="text-lg font-bold text-gray-800 m-0">Tạo Thông Báo Mới</h4>
            <button type="button" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center transition-colors" onclick="toggleAddForm()" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form action="/admin/notifications/add" method="POST">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề thông báo *</label>
                <input type="text" name="title" required placeholder="VD: Lịch nghỉ lễ 30/4..." class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none transition-colors">
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Nội dung chi tiết *</label>
                <textarea name="content" rows="3" required placeholder="Nhập nội dung cần truyền đạt..." class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none transition-colors"></textarea>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Link đính kèm (Google Drive, Hình ảnh...) - Không bắt buộc</label>
                <input type="url" name="drive_link" placeholder="https://drive.google.com/..." class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none transition-colors">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-2">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Bắt đầu hiển thị *</label>
                    <input type="datetime-local" name="start_time" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Kết thúc hiển thị *</label>
                    <input type="datetime-local" name="end_time" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none transition-colors">
                </div>
            </div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="flex-1 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-bold transition-colors flex justify-center items-center gap-2 shadow-sm">
                    <i class="bi bi-send-fill"></i> LƯU THÔNG BÁO
                </button>
                <button type="button" class="flex-1 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-bold transition-colors flex justify-center items-center gap-2" onclick="toggleAddForm()">
                    <i class="bi bi-x-circle-fill"></i> HỦY BỎ
                </button>
            </div>
        </form>
    </div>

    <h4 class="text-lg font-bold text-gray-800 mb-3">DANH SÁCH THÔNG BÁO (<%= notifications.length %>)</h4>
    
    <div class="relative mb-6">
        <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg"></i>
        <input type="text" id="search-noti" placeholder="Tìm kiếm nội dung thông báo..." onkeyup="searchItems('search-noti', '.noti-card')" class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-purple-200 focus:border-purple-500 outline-none bg-white shadow-sm transition-colors">
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    <% notifications.forEach(noti => { 
        const startTime = new Date(noti.start_time);
        const endTime = new Date(noti.end_time);
        let statusClass = '';
        let statusText = '';
        if (now < startTime) {
            statusClass = 'bg-yellow-100 text-yellow-800';
            statusText = 'Sắp hiển thị';
        } else if (now > endTime) {
            statusClass = 'bg-gray-100 text-gray-600';
            statusText = 'Đã hết hạn';
        } else {
            statusClass = 'bg-green-100 text-green-700';
            statusText = 'Đang hiển thị';
        }
    %>
        <div class="noti-card bg-white p-5 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-purple-500 hover:shadow-md transition-shadow relative flex flex-col">
            <span class="px-3 py-1 rounded-full text-xs font-bold w-max mb-3 <%= statusClass %>"><%= statusText %></span>
            <h3 class="text-lg font-bold text-gray-800 mb-2 mt-0"><%= noti.title %></h3>
            
            <p class="text-sm text-gray-500 mb-1 flex items-center gap-1"><i class="bi bi-person-circle"></i> Người tạo: <b class="text-gray-700"><%= noti.creator_name %></b></p>
            <p class="text-sm text-gray-500 mb-3 flex items-center gap-1"><i class="bi bi-clock"></i> H.lực: <%= formatDateTime(noti.start_time) %> - <%= formatDateTime(noti.end_time) %></p>
            
            <div class="bg-gray-50 p-4 rounded-lg text-sm text-gray-700 whitespace-pre-line mb-4 flex-grow border border-gray-100 break-words"><%= noti.content %></div>

            <% if(noti.drive_link) { %>
                <a href="<%= noti.drive_link %>" target="_blank" class="mb-4 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-800"><i class="bi bi-link-45deg text-lg"></i> Xem file đính kèm</a>
            <% } %>

            <div class="mt-auto">
                <div class="flex flex-wrap items-center justify-end gap-2 pt-4 border-t border-gray-100">
                    <a href="/admin/notifications/<%= noti.id %>/reads" class="px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center gap-1 transition-colors bg-blue-100 text-blue-700 hover:bg-blue-200"><i class="bi bi-people-fill"></i> Lượt đọc</a>
                    <button class="px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center gap-1 transition-colors bg-yellow-100 text-yellow-700 hover:bg-yellow-200" onclick="toggleEdit('edit-noti-<%= noti.id %>')"><i class="bi bi-pencil-square"></i> Sửa</button>
                    <form action="/admin/notifications/delete/<%= noti.id %>" method="POST" onsubmit="return confirm('Xóa thông báo này?');" class="m-0">
                        <button type="submit" class="px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center gap-1 transition-colors bg-red-100 text-red-700 hover:bg-red-200"><i class="bi bi-trash"></i> Xóa</button>
                    </form>
                </div>

                <div class="hidden mt-4 pt-4 border-t border-dashed border-gray-300" id="edit-noti-<%= noti.id %>">
                    <form action="/admin/notifications/edit/<%= noti.id %>" method="POST">
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-gray-600 mb-1">Tiêu đề</label>
                            <input type="text" name="title" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-purple-300 outline-none text-sm" value="<%= noti.title %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-gray-600 mb-1">Nội dung</label>
                            <textarea name="content" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-purple-300 outline-none text-sm" rows="3" required><%= noti.content %></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-gray-600 mb-1">Link đính kèm</label>
                            <input type="url" name="drive_link" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-purple-300 outline-none text-sm" value="<%= noti.drive_link %>">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-600 mb-1">Bắt đầu</label>
                                <input type="datetime-local" name="start_time" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-purple-300 outline-none text-sm" value="<%= new Date(noti.start_time.getTime() - (noti.start_time.getTimezoneOffset() * 60000)).toISOString().slice(0,16) %>" required>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-600 mb-1">Kết thúc</label>
                                <input type="datetime-local" name="end_time" class="w-full p-2 border border-gray-300 rounded-md focus:ring-1 focus:ring-purple-300 outline-none text-sm" value="<%= new Date(noti.end_time.getTime() - (noti.end_time.getTimezoneOffset() * 60000)).toISOString().slice(0,16) %>" required>
                            </div>
                        </div>
                        <div class="flex gap-2 mt-4">
                            <button type="submit" class="flex-1 bg-purple-600 hover:bg-purple-700 text-white py-2 rounded-md font-bold text-sm transition-colors"><i class="bi bi-check-circle-fill"></i> LƯU</button>
                            <button type="button" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 rounded-md font-bold text-sm transition-colors" onclick="toggleEdit('edit-noti-<%= noti.id %>')"><i class="bi bi-x-circle-fill"></i> HỦY</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
    </div>
</div>

    <script>
        function toggleAddForm() {
            const form = document.getElementById('add-noti-form');
            const btn = document.getElementById('btnToggleAdd');
            
            form.classList.toggle('hidden');
            if(form.classList.contains('hidden')) {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
            } else {
                btn.classList.add('hidden');
                btn.classList.remove('flex');
            }
        }

        function toggleEdit(id) {
            const el = document.getElementById(id);
            el.classList.toggle('hidden');
        }

        function searchItems(inputId, itemClass) {
            const keyword = document.getElementById(inputId).value.toLowerCase();
            const items = document.querySelectorAll(itemClass);
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(keyword) ? '' : 'none';
            });
        }

        // Loading events
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                setTimeout(() => {
                    if (!e.defaultPrevented) {
                        document.getElementById('loading-overlay').style.display = 'flex';
                    }
                }, 10);
            });
        });

        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                if (this.target === '_blank' || !this.getAttribute('href') || this.getAttribute('href').startsWith('#') || this.href.includes('javascript:')) return;
                document.getElementById('loading-overlay').style.display = 'flex';
            });
        });

        window.addEventListener('pageshow', function (event) {
            document.getElementById('loading-overlay').style.display = 'none';
        });
    </script>
</body>
</html>