<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa Thông Tin Khách Hàng - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .form-input {
            @apply w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all font-semibold text-sm;
        }
        .label-title {
            @apply block text-[11px] font-black text-slate-500 uppercase tracking-wider mb-2 ml-1;
        }
    </style>
</head>
<body class="bg-[#f8fafc] text-slate-800 pb-20">

    <nav class="bg-white/80 backdrop-blur-md p-4 shadow-sm border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto w-full flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/admin/customers" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-full flex items-center justify-center transition-all active:scale-90">
                    <i class="bi bi-arrow-left text-xl"></i>
                </a>
                <div>
                    <h1 class="font-black text-lg m-0 text-slate-800 leading-tight">Chỉnh sửa hồ sơ</h1>
                    <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-widest m-0"><%= cust.full_name %></p>
                </div>
            </div>
            <span class="hidden md:block px-3 py-1 bg-indigo-50 text-indigo-700 text-[10px] font-black rounded-lg border border-indigo-100 uppercase">Customer ID: #<%= cust.id %></span>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-4 md:p-6 mt-4">
        <form action="/admin/customers/edit/<%= cust.id %>" method="POST" class="space-y-6">
            
            <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-200">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-tight mb-4 flex items-center gap-2">
                    <div class="w-8 h-8 bg-indigo-100 text-indigo-600 rounded-lg flex items-center justify-center">
                        <i class="bi bi-person-gear"></i>
                    </div>
                    Quản lý phụ trách
                </h3>
                <div class="relative">
                    <select name="staff_id" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-indigo-500 outline-none transition-all font-bold appearance-none cursor-pointer">
                        <option value="">-- Khách tự do (Chưa giao cho ai) --</option>
                        <% staffs.forEach(staff => { %>
                            <option value="<%= staff.id %>" <%= cust.staff_id === staff.id ? 'selected' : '' %> >
                                <%= staff.full_name %>
                            </option>
                        <% }) %>
                    </select>
                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-400">
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-200 border-t-4 border-t-indigo-500">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-tight mb-6 flex items-center gap-2">
                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    Thông tin cá nhân
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label class="label-title">Họ và tên *</label>
                        <input type="text" name="full_name" value="<%= cust.full_name %>" required class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl focus:bg-white focus:border-indigo-500 outline-none transition-all font-bold text-base uppercase">
                    </div>

                    <div>
                        <label class="label-title">Số điện thoại 1 *</label>
                        <input type="text" name="phone_1" value="<%= cust.phone_1 %>" required pattern="[0-9]*" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div>
                        <label class="label-title">Số điện thoại 2</label>
                        <input type="text" name="phone_2" value="<%= cust.phone_2 %>" pattern="[0-9]*" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div>
                        <label class="label-title">Giới tính</label>
                        <div class="relative">
                            <select name="gender" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold appearance-none cursor-pointer">
                                <option value="Chưa xác định" <%= (!cust.gender || cust.gender === 'Chưa xác định') ? 'selected' : '' %>>Chưa xác định</option>
                                <option value="Nam" <%= cust.gender === 'Nam' ? 'selected' : '' %>>Nam</option>
                                <option value="Nữ" <%= cust.gender === 'Nữ' ? 'selected' : '' %>>Nữ</option>
                            </select>
                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-400"><i class="bi bi-chevron-down"></i></div>
                        </div>
                    </div>

                    <div>
                        <label class="label-title">Ngày sinh</label>
                        <input type="date" name="birthday" value="<%= cust.birthday ? new Date(cust.birthday.getTime() - (cust.birthday.getTimezoneOffset() * 60000)).toISOString().split('T')[0] : '' %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div class="md:col-span-1">
                        <label class="label-title">Email</label>
                        <input type="email" name="email" value="<%= cust.email %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div class="md:col-span-1">
                        <label class="label-title">Số CCCD</label>
                        <input type="text" name="cccd" value="<%= cust.cccd %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div class="md:col-span-2">
                        <label class="label-title">Địa chỉ thường trú</label>
                        <input type="text" name="address_1" value="<%= cust.address_1 %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>

                    <div class="md:col-span-2">
                        <label class="label-title">Địa chỉ tạm trú / Khác</label>
                        <input type="text" name="address_2" value="<%= cust.address_2 %>" class="w-full p-4 bg-slate-50 border border-slate-200 text-slate-900 rounded-2xl font-bold">
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-8 mt-4 border-t border-slate-100">
                    <button type="submit" class="flex-[2] py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-sm uppercase tracking-widest transition-all shadow-lg shadow-indigo-100 active:scale-95 flex justify-center items-center gap-2">
                        <i class="bi bi-check-lg text-lg"></i> Cập Nhật Hồ Sơ
                    </button>
                    <a href="/admin/customers" class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-black text-sm uppercase tracking-widest transition-all flex justify-center items-center gap-2">
                        Hủy Bỏ
                    </a>
                </div>
            </div>
        </form>
    </div>
</body>
</html>