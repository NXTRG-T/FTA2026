<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Từ Điển Tag - FTA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>

<body class="text-slate-800 pb-20">

    <div class="max-w-[1400px] mx-auto p-4 md:p-6 md:pt-8">

        <div class="mb-4">
            <a href="/admin/dashboard"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:border-pink-400 text-slate-600 hover:text-pink-600 rounded-xl font-black text-xs uppercase tracking-widest shadow-sm transition-all group">
                <i class="bi bi-arrow-left text-base group-hover:-translate-x-1 transition-transform"></i> Về Dashboard
            </a>
        </div>

        <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-white p-5 md:p-6 rounded-[2rem] shadow-sm border border-slate-200">
            <div>
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight m-0 flex items-center gap-2">
                    <i class="bi bi-tags-fill text-pink-500"></i> Từ Điển Tag
                </h2>
                <p class="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1 m-0">Quản lý nhãn phân
                    loại khách hàng</p>
            </div>

            <div class="shrink-0">
                <button
                    class="px-6 py-3 bg-pink-600 text-white hover:bg-pink-700 rounded-xl font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 shadow-lg shadow-pink-200 hover:-translate-y-1"
                    onclick="toggleAdd()">
                    <i class="bi bi-plus-lg text-base"></i> TẠO TAG MỚI
                </button>
            </div>
        </div>

        <div class="hidden bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-200 mb-8 transition-all border-t-4 border-t-pink-500"
            id="add-tag-form">
            <h4 class="text-lg font-black text-slate-800 mb-6 mt-0 flex items-center gap-2">
                <i class="bi bi-tag text-pink-500"></i> Định Nghĩa Tag Mới
            </h4>

            <form action="/admin/tags/add" method="POST">
                <div class="mb-6">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Tên Nhãn
                        (Tag) *</label>
                    <input type="text" name="tag_name" placeholder="VD: Khách VIP, Đã chốt hợp đồng..." required
                        class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-pink-400 focus:border-pink-400 outline-none transition-all font-bold text-slate-800">
                </div>

                <div class="flex items-center gap-4 mb-8 p-4 bg-slate-50 border border-slate-200 rounded-2xl">
                    <span class="font-black text-xs text-slate-500 uppercase tracking-widest">Chọn màu đại diện:</span>
                    <input type="color" name="color_code" value="#ec4899"
                        class="w-12 h-12 border-0 rounded-xl cursor-pointer bg-transparent p-0">
                </div>

                <div class="flex gap-3">
                    <button type="submit"
                        class="flex-1 py-4 bg-pink-600 hover:bg-pink-700 text-white font-black text-xs uppercase tracking-widest rounded-2xl transition-all shadow-md shadow-pink-200 flex justify-center items-center gap-2 hover:-translate-y-1">
                        <i class="bi bi-check-circle-fill"></i> LƯU DANH MỤC
                    </button>
                    <button type="button"
                        class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 font-black text-xs uppercase tracking-widest rounded-2xl transition-all flex justify-center items-center gap-2"
                        onclick="toggleAdd()">
                        <i class="bi bi-x-circle-fill"></i> HỦY BỎ
                    </button>
                </div>
            </form>
        </div>

        <h4 class="font-black text-slate-800 text-lg mb-4 flex items-center gap-2 uppercase tracking-widest">
            DANH SÁCH HIỆN CÓ <span class="bg-pink-100 text-pink-700 px-3 py-1 rounded-full text-xs shadow-sm">
                <%= tags.length %>
            </span>
        </h4>

        <% if(tags.length===0) { %>
            <div class="bg-white py-12 rounded-[2.5rem] shadow-sm border border-dashed border-slate-300 text-center">
                <i class="bi bi-tags text-5xl text-slate-300 mb-3 block"></i>
                <p class="text-slate-500 font-bold m-0">Chưa có tag nào được tạo.<br>Hãy tạo thêm tag để phân loại khách
                    hàng dễ dàng hơn!</p>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    <% tags.forEach(tag=> { %>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex justify-between items-center group hover:shadow-md hover:-translate-y-1 transition-all"
                            style="border-left-width: 6px; border-left-color: <%= tag.color_code %>;">
                            <div class="flex items-center gap-3">
                                <div class="w-5 h-5 rounded-full shadow-sm border border-white"
                                    style="background-color: <%= tag.color_code %>;"></div>
                                <strong class="text-slate-800 font-black text-sm uppercase tracking-wide">
                                    <%= tag.tag_name %>
                                </strong>
                            </div>

                            <div class="flex items-center gap-1">
                                <button type="button"
                                    onclick="openEditModal('<%= tag.id %>', '<%= tag.tag_name %>', '<%= tag.color_code %>')"
                                    class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-300 hover:bg-amber-50 hover:text-amber-600 transition-colors"
                                    title="Sửa Tag">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <form action="/admin/tags/delete/<%= tag.id %>" method="POST"
                                    onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn nhãn [<%= tag.tag_name %>] không?')"
                                    class="m-0">
                                    <button type="submit"
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-300 hover:bg-rose-50 hover:text-rose-500 transition-colors"
                                        title="Xóa Tag">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </div>

    <dialog id="editTagModal"
        class="border-none p-4 bg-transparent m-auto w-full max-w-md backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm outline-none">
        <div class="bg-white w-full rounded-3xl shadow-2xl overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="text-lg font-black text-slate-800 m-0">Chỉnh sửa nhãn</h3>
                <button type="button" onclick="closeEditModal()"
                    class="w-8 h-8 flex justify-center items-center rounded-xl bg-slate-200 text-slate-600 hover:bg-rose-500 hover:text-white transition-colors">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="editTagForm" method="POST" class="p-6">
                <div class="mb-6">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2 ml-1">Tên Nhãn
                        (Tag) *</label>
                    <input type="text" name="tag_name" id="edit_tag_name" required
                        class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-amber-400 outline-none transition-all font-bold">
                </div>

                <div class="flex items-center gap-4 mb-8 p-4 bg-slate-50 border border-slate-200 rounded-2xl">
                    <span class="font-black text-xs text-slate-500 uppercase tracking-widest">Màu đại diện:</span>
                    <input type="color" name="color_code" id="edit_color_code"
                        class="w-12 h-12 border-0 rounded-xl cursor-pointer bg-transparent p-0">
                </div>

                <div class="flex gap-3">
                    <button type="submit"
                        class="flex-[2] py-4 bg-indigo-600 text-white font-black text-xs uppercase rounded-2xl shadow-lg active:scale-95 transition-all">LƯU
                        THAY ĐỔI</button>
                    <button type="button" onclick="closeEditModal()"
                        class="flex-1 py-4 bg-slate-100 text-slate-600 font-black text-xs uppercase rounded-2xl">HỦY</button>
                </div>
            </form>
        </div>
    </dialog>

    <script>
        // Ẩn/Hiện form thêm mới
        function toggleAdd() {
            const form = document.getElementById('add-tag-form');
            form.classList.toggle('hidden');
        }

        // Mở modal sửa và điền dữ liệu
        function openEditModal(id, name, color) {
            const modal = document.getElementById('editTagModal');
            const form = document.getElementById('editTagForm');
            const nameInput = document.getElementById('edit_tag_name');
            const colorInput = document.getElementById('edit_color_code');

            // Cập nhật Action của Form theo ID của Tag
            form.action = '/admin/tags/edit/' + id;

            // Đổ dữ liệu cũ vào các ô nhập liệu
            nameInput.value = name;
            colorInput.value = color;

            // Hiển thị Modal
            modal.showModal();

            // Khóa cuộn trang web chính
            document.body.style.overflow = 'hidden';
        }

        // Đóng modal sửa
        function closeEditModal() {
            const modal = document.getElementById('editTagModal');
            modal.close();

            // Mở lại cuộn trang web chính
            document.body.style.overflow = '';
        }

        // Đóng modal khi click ra ngoài vùng trắng (backdrop)
        document.getElementById('editTagModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeEditModal();
            }
        });
    </script>
</body>

</html>